import NormalizerLean.CardB
import NormalizerLean.ExplicitFormula

/-!
# T4, part 1: C(N) is generated by S_h and R = [[1, 0], [N/h, 1]] ([BA], "Proof of the normalizer
order and generation")

The h² elements Rⁱ Sʲ (0 ≤ i, j < h) are distinct in B(N); |C(N)| = h² ∏_{p ∣ N, v_p(n) = 0} (1 + 1/p)
≤ 2h², with equality only if 2, 3 ∣ h and 2, 3 ∤ n, and in that case S R^ℓ (1 + ℓn ≡ 0 mod h) is a
further element of ⟨R, S⟩.  Lagrange then gives ⟨R, S⟩ = C(N).
-/

open Matrix MatrixGroups

namespace NormalizerLean

noncomputable section

/-- R = [[1, 0], [N/h, 1]]. -/
def Rmat (N : ℕ) : SL(2, ℝ) :=
  ⟨!![1, 0; (N : ℝ) / hPart N, 1], by simp [det_fin_two_of]⟩

theorem coe_Rmat_pow (N i : ℕ) :
    ((Rmat N ^ i : SL(2, ℝ)) : Matrix (Fin 2) (Fin 2) ℝ) = !![1, 0; (i : ℝ) * (N / hPart N), 1] := by
  induction i with
  | zero => ext a b; fin_cases a <;> fin_cases b <;> simp
  | succ i ih =>
    rw [pow_succ, Matrix.SpecialLinearGroup.coe_mul, ih]
    simp only [Rmat, mul_fin_two]
    congr 1 <;> push_cast <;> ring

theorem Rmat_isNewmanForm (N : ℕ) [NeZero N] : IsNewmanForm N (Rmat N) := by
  refine ⟨1, 0, 1, 1, 1, one_pos, one_dvd _, by simp, 1, Or.inl rfl, ?_⟩
  ext a b; fin_cases a <;> fin_cases b <;> simp [Rmat]

theorem S_isNewmanForm (N : ℕ) [NeZero N] : IsNewmanForm N (S (hPart N)) := by
  refine ⟨1, 1, 0, 1, 1, one_pos, one_dvd _, by simp, 1, Or.inl rfl, ?_⟩
  ext a b; fin_cases a <;> fin_cases b <;> simp [S]

theorem Rmat_mem (N : ℕ) [NeZero N] : Rmat N ∈ Norm0 N :=
  newmanForm_mem_normalizer' (Rmat_isNewmanForm N)

theorem S_h_mem (N : ℕ) [NeZero N] : S (hPart N) ∈ Norm0 N :=
  S_mem_normalizer' dvd_rfl

/-- Elements of the form Rⁱ Sʲ. -/
theorem coe_RS (N i j : ℕ) :
    ((Rmat N ^ i * S (hPart N) ^ j : SL(2, ℝ)) : Matrix (Fin 2) (Fin 2) ℝ) =
      !![1, (j : ℝ) / hPart N; (i : ℝ) * (N / hPart N),
        1 + (i : ℝ) * (N / hPart N) * (j / hPart N)] := by
  rw [Matrix.SpecialLinearGroup.coe_mul, coe_Rmat_pow, coe_S_pow, mul_fin_two]
  congr 1 <;> ring

/-- Lower-left entry of an element of Γ₀(N), real form. -/
theorem lowerLeft_of_mem {N : ℕ} {g : SL(2, ℝ)} (hg : g ∈ Gamma0R N) :
    ∃ c : ℤ, (g : Matrix (Fin 2) (Fin 2) ℝ) 1 0 = (N : ℝ) * c := by
  obtain ⟨a, b, c, d, -, ⟨c', rfl⟩, hm⟩ := exists_entries_of_mem_Gamma0R hg
  exact ⟨c', by rw [hm]; simp⟩

theorem upperRight_of_mem {N : ℕ} {g : SL(2, ℝ)} (hg : g ∈ Gamma0R N) :
    ∃ b : ℤ, (g : Matrix (Fin 2) (Fin 2) ℝ) 0 1 = b := by
  obtain ⟨a, b, c, d, -, -, hm⟩ := exists_entries_of_mem_Gamma0R hg
  exact ⟨b, by rw [hm]; simp⟩

/-- The h² elements Rⁱ Sʲ are distinct modulo Γ₀(N). -/
theorem RS_inj {N : ℕ} [NeZero N] {i j i' j' : ℕ} (hi : i < hPart N) (hi' : i' < hPart N)
    (hj : j < hPart N) (hj' : j' < hPart N)
    (h : (Rmat N ^ i' * S (hPart N) ^ j')⁻¹ * (Rmat N ^ i * S (hPart N) ^ j) ∈ Gamma0R N) :
    i = i' ∧ j = j' := by
  have hh0 : (hPart N : ℝ) ≠ 0 := Nat.cast_ne_zero.2 (hPart_pos N).ne'
  have hN0 : (N : ℝ) ≠ 0 := Nat.cast_ne_zero.2 (NeZero.ne N)
  have hcoe : (((Rmat N ^ i' * S (hPart N) ^ j')⁻¹ * (Rmat N ^ i * S (hPart N) ^ j) : SL(2, ℝ)) :
      Matrix (Fin 2) (Fin 2) ℝ) 1 0 = ((i : ℝ) - i') * (N / hPart N) := by
    rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv, coe_RS, coe_RS,
      adjugate_fin_two]
    simp [Matrix.mul_apply, Fin.sum_univ_two]
    ring
  obtain ⟨c, hc⟩ := lowerLeft_of_mem h
  rw [hcoe] at hc
  -- (i − i') = h c
  have hii : ((i : ℤ) - i') = hPart N * c := by
    have : ((i : ℝ) - i') = hPart N * c := by
      field_simp at hc
      linear_combination hc
    exact_mod_cast this
  have hieq : i = i' := by
    have := Int.eq_zero_of_abs_lt_dvd ⟨c, hii⟩ (by rw [abs_lt]; constructor <;> omega)
    omega
  subst hieq
  refine ⟨rfl, ?_⟩
  -- now the element is S^{j - j'}
  have hcoe2 : (((Rmat N ^ i * S (hPart N) ^ j')⁻¹ * (Rmat N ^ i * S (hPart N) ^ j) : SL(2, ℝ)) :
      Matrix (Fin 2) (Fin 2) ℝ) 0 1 = ((j : ℝ) - j') / hPart N := by
    rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv, coe_RS, coe_RS,
      adjugate_fin_two]
    simp [Matrix.mul_apply, Fin.sum_univ_two]
    field_simp
    ring
  obtain ⟨b, hb⟩ := upperRight_of_mem h
  rw [hcoe2] at hb
  have hjj : ((j : ℤ) - j') = hPart N * b := by
    have : ((j : ℝ) - j') = hPart N * b := by
      field_simp at hb
      linear_combination hb
    exact_mod_cast this
  have := Int.eq_zero_of_abs_lt_dvd ⟨b, hjj⟩ (by rw [abs_lt]; constructor <;> omega)
  omega

/-- The extra element S R^ℓ in the case 1 + ℓ n ≡ 0 (mod h), h > 1. -/
theorem SR_not_RS {N : ℕ} [NeZero N] {ℓ : ℕ} (hℓ : (hPart N : ℤ) ∣ 1 + ℓ * nPart N)
    (hh1 : 1 < hPart N) (i j : ℕ) :
    (Rmat N ^ i * S (hPart N) ^ j)⁻¹ * (S (hPart N) * Rmat N ^ ℓ) ∉ Gamma0R N := by
  intro h
  have hh0 : (hPart N : ℝ) ≠ 0 := Nat.cast_ne_zero.2 (hPart_pos N).ne'
  have hNnh := hPart_sq_mul_nPart N (NeZero.ne N)
  have hNr : (N : ℝ) = nPart N * (hPart N) ^ 2 := by exact_mod_cast hNnh.symm
  have hcoe : (((Rmat N ^ i * S (hPart N) ^ j)⁻¹ * (S (hPart N) * Rmat N ^ ℓ) : SL(2, ℝ)) :
      Matrix (Fin 2) (Fin 2) ℝ) 1 0 =
        (N / hPart N) * ((ℓ : ℝ) - i * (1 + ℓ * nPart N)) := by
    rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul,
      Matrix.SpecialLinearGroup.coe_inv, coe_RS, coe_S, coe_Rmat_pow, adjugate_fin_two]
    simp [Matrix.mul_apply, Fin.sum_univ_two, hNr]
    field_simp
    ring
  obtain ⟨c, hc⟩ := lowerLeft_of_mem h
  rw [hcoe] at hc
  have hint : ((ℓ : ℤ) - i * (1 + ℓ * nPart N)) = hPart N * c := by
    have : ((ℓ : ℝ) - i * (1 + ℓ * nPart N)) = hPart N * c := by
      have hN0 : (N : ℝ) ≠ 0 := Nat.cast_ne_zero.2 (NeZero.ne N)
      field_simp at hc
      exact hc
    exact_mod_cast this
  -- h ∣ ℓ, then h ∣ 1
  have hdℓ : (hPart N : ℤ) ∣ ℓ := by
    have : (hPart N : ℤ) ∣ (ℓ : ℤ) - i * (1 + ℓ * nPart N) := ⟨c, hint⟩
    have := dvd_add this (dvd_mul_of_dvd_right hℓ (i : ℤ))
    simpa using this
  have h1 : (hPart N : ℤ) ∣ 1 := by
    have := dvd_sub hℓ (dvd_mul_of_dvd_left hdℓ (nPart N : ℤ))
    simpa using this
  have := Int.le_of_dvd one_pos h1
  omega

/-! ### |C(N)| = h² Q -/

theorem nPart_ne_zero (N : ℕ) [NeZero N] : nPart N ≠ 0 := by
  intro h0
  have := hPart_sq_mul_nPart N (NeZero.ne N)
  rw [h0, zero_mul] at this
  exact NeZero.ne N this.symm

theorem psi_nPart_eq_prod (N : ℕ) [NeZero N] :
    psi (nPart N) = ∏ p ∈ N.primeFactors, ((p : ℚ) ^ (nPart N).factorization p *
      (if 0 < (nPart N).factorization p then 1 + 1 / (p : ℚ) else 1)) := by
  have hN := NeZero.ne N
  have hn0 := nPart_ne_zero N
  have hnN : nPart N ∣ N := ⟨hPart N ^ 2, (hPart_sq_mul_nPart N hN).symm⟩
  have hsub : (nPart N).primeFactors ⊆ N.primeFactors := Nat.primeFactors_mono hnN hN
  have hmem : ∀ p ∈ N.primeFactors,
      (p ∈ (nPart N).primeFactors ↔ 0 < (nPart N).factorization p) := by
    intro p hp
    have hpp := Nat.prime_of_mem_primeFactors hp
    rw [Nat.mem_primeFactors]
    constructor
    · exact fun h => (hpp.dvd_iff_one_le_factorization hn0).1 h.2.1
    · exact fun h => ⟨hpp, (hpp.dvd_iff_one_le_factorization hn0).2 h, hn0⟩
  rw [psi_eq_prod hn0]
  have step1 : ∏ p ∈ (nPart N).primeFactors, ((p : ℚ) ^ (nPart N).factorization p *
      (1 + 1 / (p : ℚ))) = ∏ p ∈ (nPart N).primeFactors, ((p : ℚ) ^ (nPart N).factorization p *
      (if 0 < (nPart N).factorization p then 1 + 1 / (p : ℚ) else 1)) :=
    Finset.prod_congr rfl (fun p hp => by rw [if_pos ((hmem p (hsub hp)).1 hp)])
  rw [step1]
  apply Finset.prod_subset hsub
  intro p hp hpn
  have h0 : (nPart N).factorization p = 0 := by
    by_contra h
    exact hpn ((hmem p hp).2 (Nat.pos_of_ne_zero h))
  simp [h0]

theorem hPart_eq_prod (N : ℕ) [NeZero N] :
    (hPart N : ℚ) = ∏ p ∈ N.primeFactors, (p : ℚ) ^ (hPart N).factorization p := by
  have hN := NeZero.ne N
  have hh0 := (hPart_pos N).ne'
  have hhN : hPart N ∣ N := dvd_trans (dvd_pow_self _ two_ne_zero) (hPart_sq_dvd hN)
  rw [cast_eq_prod_pow hh0]
  apply Finset.prod_subset (Nat.primeFactors_mono hhN hN)
  intro p _ hpn
  have : (hPart N).factorization p = 0 := by
    by_contra h
    exact hpn (Nat.mem_primeFactors.2 ⟨Nat.prime_of_mem_primeFactors ‹_›,
      (Nat.prime_of_mem_primeFactors ‹_›).dvd_iff_one_le_factorization hh0 |>.2
        (Nat.pos_of_ne_zero h), hh0⟩)
  simp [this]

/-- Q = ∏_{p ∣ N} [v_p(n) = 0 ? 1 + 1/p : 1]. -/
def Qfac (N : ℕ) : ℚ :=
  ∏ p ∈ N.primeFactors, (if 0 < (nPart N).factorization p then 1 else 1 + 1 / (p : ℚ))

theorem card_CN_eq (N : ℕ) [NeZero N] :
    (Nat.card (CN N) : ℚ) = (hPart N : ℚ) ^ 2 * Qfac N := by
  have hN := NeZero.ne N
  rw [card_CN', psi_eq_prod hN, psi_nPart_eq_prod, hPart_eq_prod, Qfac, ← Finset.prod_pow,
    ← Finset.prod_mul_distrib, ← Finset.prod_div_distrib]
  apply Finset.prod_congr rfl
  intro p hp
  have hp0 : (p : ℚ) ≠ 0 := Nat.cast_ne_zero.2 (Nat.prime_of_mem_primeFactors hp).ne_zero
  have hp1 : (1 : ℚ) + 1 / p ≠ 0 := by positivity
  have hν := factorization_nPart (p := p) hN
  rw [show N.factorization p = (nPart N).factorization p + 2 * (hPart N).factorization p
    by omega, pow_add, ← pow_mul]
  split_ifs <;> field_simp <;> ring

/-- Q ≤ 2, with equality only in the special case. -/
theorem Qfac_cases (N : ℕ) [NeZero N] :
    Qfac N < 2 ∨ (Qfac N = 2 ∧ 2 ∣ hPart N ∧ 3 ∣ hPart N ∧ Nat.Coprime (nPart N) (hPart N)) := by
  have hN := NeZero.ne N
  have hn0 := nPart_ne_zero N
  -- factors at p ∉ {2, 3} are 1
  have hother : ∀ p ∈ N.primeFactors, p ≠ 2 → p ≠ 3 → 0 < (nPart N).factorization p := by
    intro p hp h2 h3
    have hk := factorization_hPart N p
    rw [if_neg h2, if_neg h3] at hk
    have := factorization_nPart (p := p) hN
    have hpos := (Nat.prime_of_mem_primeFactors hp).factorization_pos_of_dvd hN
      (Nat.dvd_of_mem_primeFactors hp)
    omega
  have hsplit : Qfac N = (if 2 ∈ N.primeFactors ∧ (nPart N).factorization 2 = 0 then 3 / 2 else 1) *
      (if 3 ∈ N.primeFactors ∧ (nPart N).factorization 3 = 0 then 4 / 3 else 1) := by
    unfold Qfac
    have : ∀ p ∈ N.primeFactors, (if 0 < (nPart N).factorization p then (1 : ℚ) else 1 + 1 / (p : ℚ)) =
        (if p = 2 then (if (nPart N).factorization 2 = 0 then 3 / 2 else 1) else 1) *
        (if p = 3 then (if (nPart N).factorization 3 = 0 then 4 / 3 else 1) else 1) := by
      intro p hp
      by_cases h2 : p = 2
      · subst h2
        by_cases h0 : (nPart N).factorization 2 = 0 <;> simp [h0] <;> norm_num
      by_cases h3 : p = 3
      · subst h3
        by_cases h0 : (nPart N).factorization 3 = 0 <;> simp [h0] <;> norm_num
      simp [h2, h3, hother p hp h2 h3]
    rw [Finset.prod_congr rfl this, Finset.prod_mul_distrib, Finset.prod_ite_eq',
      Finset.prod_ite_eq']
    by_cases a2 : 2 ∈ N.primeFactors <;> by_cases a3 : 3 ∈ N.primeFactors <;> simp [a2, a3]
  rw [hsplit]
  by_cases c2 : 2 ∈ N.primeFactors ∧ (nPart N).factorization 2 = 0 <;>
    by_cases c3 : 3 ∈ N.primeFactors ∧ (nPart N).factorization 3 = 0
  · right
    refine ⟨by rw [if_pos c2, if_pos c3]; norm_num, ?_, ?_, ?_⟩
    · -- v₂(n) = 0 and 2 ∣ N force 2 ∣ h
      have hν := factorization_nPart (p := 2) hN
      have hpos := Nat.prime_two.factorization_pos_of_dvd hN (Nat.dvd_of_mem_primeFactors c2.1)
      have hk : 0 < (hPart N).factorization 2 := by omega
      exact (Nat.prime_two.dvd_iff_one_le_factorization (hPart_pos N).ne').2 hk
    · have hν := factorization_nPart (p := 3) hN
      have hpos := Nat.prime_three.factorization_pos_of_dvd hN (Nat.dvd_of_mem_primeFactors c3.1)
      have hk : 0 < (hPart N).factorization 3 := by omega
      exact (Nat.prime_three.dvd_iff_one_le_factorization (hPart_pos N).ne').2 hk
    · -- h = 2^i 3^j, and 2, 3 ∤ n
      unfold hPart
      apply Nat.Coprime.mul_right <;> apply Nat.Coprime.pow_right
      · rw [Nat.coprime_comm, Nat.Prime.coprime_iff_not_dvd Nat.prime_two]
        intro hd
        have := (Nat.prime_two.dvd_iff_one_le_factorization hn0).1 hd
        omega
      · rw [Nat.coprime_comm, Nat.Prime.coprime_iff_not_dvd Nat.prime_three]
        intro hd
        have := (Nat.prime_three.dvd_iff_one_le_factorization hn0).1 hd
        omega
  · left; rw [if_pos c2, if_neg c3]; norm_num
  · left; rw [if_neg c2, if_pos c3]; norm_num
  · left; rw [if_neg c2, if_neg c3]; norm_num

/-! ### C(N) = ⟨S, R⟩ -/

theorem S_NData (N : ℕ) [NeZero N] : NData N (S (hPart N)) 1 1 0 1 1 1 := by
  refine ⟨one_pos, one_dvd _, by simp, Or.inl rfl, ?_⟩
  ext a b; fin_cases a <;> fin_cases b <;> simp [S]

theorem R_NData (N : ℕ) [NeZero N] : NData N (Rmat N) 1 0 1 1 1 1 := by
  refine ⟨one_pos, one_dvd _, by simp, Or.inl rfl, ?_⟩
  ext a b; fin_cases a <;> fin_cases b <;> simp [Rmat]

/-- The classes of S_h and R in B(N). -/
def sC (N : ℕ) [NeZero N] : B N := QuotientGroup.mk ⟨S (hPart N), S_h_mem N⟩
def rC (N : ℕ) [NeZero N] : B N := QuotientGroup.mk ⟨Rmat N, Rmat_mem N⟩

theorem mem_CN_of_conj {N : ℕ} [NeZero N] {g : SL(2, ℝ)} (hg : g ∈ conjGamma0n N)
    (hgN : g ∈ Norm0 N) : (QuotientGroup.mk ⟨g, hgN⟩ : B N) ∈ CN N :=
  ⟨⟨g, hgN⟩, Subgroup.mem_subgroupOf.2 hg, rfl⟩

theorem rC_pow_mul_sC_pow (N : ℕ) [NeZero N] (i j : ℕ) :
    rC N ^ i * sC N ^ j = QuotientGroup.mk
      ⟨Rmat N ^ i * S (hPart N) ^ j, mul_mem (pow_mem (Rmat_mem N) i) (pow_mem (S_h_mem N) j)⟩ := by
  rfl

theorem CN_eq_closure (N : ℕ) [NeZero N] : CN N = Subgroup.closure {sC N, rC N} := by
  set K := Subgroup.closure {sC N, rC N}
  have hK : K ≤ CN N := by
    rw [Subgroup.closure_le]
    rintro x (rfl | rfl)
    · exact mem_CN_of_conj (S_NData N).mem_conjGamma0n _
    · exact mem_CN_of_conj (R_NData N).mem_conjGamma0n _
  have : Finite (B N) := finite_B' N
  have hh0 : 0 < hPart N := hPart_pos N
  have hmemK : ∀ i j : ℕ, rC N ^ i * sC N ^ j ∈ K := fun i j =>
    mul_mem (pow_mem (Subgroup.subset_closure (by simp)) i)
      (pow_mem (Subgroup.subset_closure (by simp)) j)
  have hinj : ∀ i j i' j' : ℕ, i < hPart N → j < hPart N → i' < hPart N → j' < hPart N →
      rC N ^ i * sC N ^ j = rC N ^ i' * sC N ^ j' → i = i' ∧ j = j' := by
    intro i j i' j' hi hj hi' hj' heq
    rw [rC_pow_mul_sC_pow, rC_pow_mul_sC_pow, B.mk_eq_mk_iff] at heq
    have := RS_inj (i := i') (j := j') (i' := i) (j' := j) hi' hi hj' hj heq
    exact ⟨this.1.symm, this.2.symm⟩
  let F : Fin (hPart N) × Fin (hPart N) → K :=
    fun ij => ⟨rC N ^ (ij.1 : ℕ) * sC N ^ (ij.2 : ℕ), hmemK _ _⟩
  have hF : Function.Injective F := by
    rintro ⟨i, j⟩ ⟨i', j'⟩ heq
    have := hinj i j i' j' i.2 j.2 i'.2 j'.2 (congrArg Subtype.val heq)
    ext <;> simp [this.1, this.2]
  have hcardK : hPart N ^ 2 ≤ Nat.card K := by
    have := Nat.card_le_card_of_injective F hF
    simpa [Nat.card_eq_fintype_card, Fintype.card_prod, Fintype.card_fin, pow_two] using this
  have hdvd : Nat.card K ∣ Nat.card (CN N) := Subgroup.card_dvd_of_le hK
  have hc := card_CN_eq N
  have key : 2 * Nat.card K > Nat.card (CN N) → K = CN N := by
    intro hgt
    obtain ⟨t, ht⟩ := hdvd
    have hpos : 0 < Nat.card K := by nlinarith
    have ht1 : t = 1 := by
      rcases Nat.lt_or_ge t 2 with h1 | h2
      · interval_cases t
        · simp at ht; have := Nat.card_pos (α := CN N); omega
        · rfl
      · nlinarith
    exact Subgroup.eq_of_le_of_card_ge hK (by rw [ht, ht1, mul_one])
  symm
  have hpos : (0 : ℚ) < (hPart N : ℚ) ^ 2 := by positivity
  rcases Qfac_cases N with hQ | ⟨hQ, h2, h3, hcop⟩
  · apply key
    have : (Nat.card (CN N) : ℚ) < 2 * (hPart N : ℚ) ^ 2 := by
      rw [hc]; nlinarith [mul_lt_mul_of_pos_left hQ hpos]
    have : Nat.card (CN N) < 2 * hPart N ^ 2 := by exact_mod_cast this
    omega
  · apply key
    have hc2 : Nat.card (CN N) = 2 * hPart N ^ 2 := by
      have : (Nat.card (CN N) : ℚ) = 2 * (hPart N : ℚ) ^ 2 := by rw [hc, hQ]; ring
      exact_mod_cast this
    have hh1 : 1 < hPart N := by have := Nat.le_of_dvd hh0 h2; omega
    -- ℓ with h ∣ 1 + ℓ n, from Bézout
    obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : ℕ, (hPart N : ℤ) ∣ 1 + ℓ * nPart N := by
      have hb := Int.gcd_eq_gcd_ab (nPart N) (hPart N)
      rw [Int.gcd_natCast_natCast, hcop] at hb
      have hh0z : (0 : ℤ) < hPart N := by exact_mod_cast hh0
      refine ⟨((-Int.gcdA (nPart N) (hPart N)) % (hPart N : ℤ)).toNat, ?_⟩
      rw [Int.toNat_of_nonneg (Int.emod_nonneg _ hh0z.ne')]
      refine ⟨Int.gcdB (nPart N) (hPart N) -
        nPart N * ((-Int.gcdA (nPart N) (hPart N)) / (hPart N : ℤ)), ?_⟩
      rw [Int.emod_def]
      push_cast at hb
      linear_combination hb
    have hextra : sC N * rC N ^ ℓ ∈ K :=
      mul_mem (Subgroup.subset_closure (by simp)) (pow_mem (Subgroup.subset_closure (by simp)) ℓ)
    have hne : ∀ i j : ℕ, rC N ^ i * sC N ^ j ≠ sC N * rC N ^ ℓ := by
      intro i j heq
      rw [rC_pow_mul_sC_pow] at heq
      have heq' : (QuotientGroup.mk ⟨Rmat N ^ i * S (hPart N) ^ j,
          mul_mem (pow_mem (Rmat_mem N) i) (pow_mem (S_h_mem N) j)⟩ : B N) =
          QuotientGroup.mk ⟨S (hPart N) * Rmat N ^ ℓ,
            mul_mem (S_h_mem N) (pow_mem (Rmat_mem N) ℓ)⟩ := heq
      rw [B.mk_eq_mk_iff] at heq'
      exact SR_not_RS hℓ hh1 i j heq'
    let G : Option (Fin (hPart N) × Fin (hPart N)) → K := fun o => match o with
      | none => ⟨sC N * rC N ^ ℓ, hextra⟩
      | some ij => F ij
    have hG : Function.Injective G := by
      rintro (_ | ⟨i, j⟩) (_ | ⟨i', j'⟩) heq
      · rfl
      · exact absurd (congrArg Subtype.val heq).symm (hne i' j')
      · exact absurd (congrArg Subtype.val heq) (hne i j)
      · exact congrArg some (hF heq)
    have := Nat.card_le_card_of_injective G hG
    simp [Nat.card_eq_fintype_card, Fintype.card_option, Fintype.card_prod, Fintype.card_fin] at this
    nlinarith

end

end NormalizerLean
