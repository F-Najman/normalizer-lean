module

public import NormalizerLean.GenAL
public import NormalizerLean.GlobalRels

@[expose] public section

/-!
# T4: B(N) is generated by the local generators

Let H be the subgroup generated by the classes w_{m_p} and S_{h(m_p)}, p ∣ N.

* [S_h] ∈ H: h = h(m₂) h(m₃) with coprime factors, and S_{ab} = S_a^x S_b^y when xb + ya = 1.
* [w_N] ∈ H: w_{m_p} w_Q is an Atkin–Lehner element for m_p Q, and ∏_p m_p = N.
* R = w_N S_h⁻¹ w_N⁻¹, so C(N) = ⟨[S_h], [R]⟩ ≤ H.
* σ([w_{m_p}]) is the indicator of p (p ∣ n), so σ(H) is everything; as ker σ = C(N) ≤ H, H = B(N).
-/

open Matrix MatrixGroups

namespace NormalizerLean

noncomputable section

/-! ### Integer powers of S_k -/

/-- t ↦ [[1, t], [0, 1]]. -/
def upT : Multiplicative ℝ →* SL(2, ℝ) where
  toFun t := ⟨!![1, Multiplicative.toAdd t; 0, 1], by simp [det_fin_two_of]⟩
  map_one' := by
    ext i j; fin_cases i <;> fin_cases j <;> simp
  map_mul' s t := by
    apply Subtype.ext
    change !![1, Multiplicative.toAdd (s * t); 0, 1] =
      !![1, Multiplicative.toAdd s; 0, 1] * !![1, Multiplicative.toAdd t; 0, 1]
    rw [mul_fin_two, toAdd_mul]
    simp [add_comm]

theorem S_eq_upT (k : ℕ) : S k = upT (Multiplicative.ofAdd (k : ℝ)⁻¹) :=
  Subtype.ext rfl

theorem S_zpow (k : ℕ) (j : ℤ) :
    S k ^ j = upT (Multiplicative.ofAdd ((j : ℝ) * (k : ℝ)⁻¹)) := by
  rw [S_eq_upT, ← map_zpow, ← ofAdd_zsmul, zsmul_eq_mul]

theorem S_mul_eq_zpow {a b : ℕ} (ha : a ≠ 0) (hb : b ≠ 0) {x y : ℤ} (hxy : x * b + y * a = 1) :
    S (a * b) = S a ^ x * S b ^ y := by
  have ha' : (a : ℝ) ≠ 0 := Nat.cast_ne_zero.2 ha
  have hb' : (b : ℝ) ≠ 0 := Nat.cast_ne_zero.2 hb
  have hxy' : (x : ℝ) * b + y * a = 1 := by exact_mod_cast hxy
  have key : (x : ℝ) * (a : ℝ)⁻¹ + (y : ℝ) * (b : ℝ)⁻¹ = ((a * b : ℕ) : ℝ)⁻¹ := by
    push_cast
    field_simp
    linear_combination hxy'
  rw [S_zpow, S_zpow, ← map_mul, ← ofAdd_add, key, S_eq_upT]

/-! ### The subgroup H -/

/-- H = ⟨w_{m_p}, S_{h(m_p)} : p ∣ N⟩. -/
abbrev Hloc (N : ℕ) : Subgroup (B N) := Subgroup.closure (⋃ p ∈ N.primeFactors, localGens N p)

theorem localGens_subset {N p : ℕ} (hp : p ∈ N.primeFactors) : localGens N p ⊆ Hloc N :=
  fun _ hx => Subgroup.subset_closure (Set.mem_iUnion₂.2 ⟨p, hp, hx⟩)

theorem mPart_dvd (N p : ℕ) : mPart N p ∣ N := Nat.ordProj_dvd N p

theorem hPart_mPart_dvd (N p : ℕ) [NeZero N] : hPart (mPart N p) ∣ hPart N := by
  have hN := NeZero.ne N
  have hm0 : mPart N p ≠ 0 := (Nat.ordProj_pos N p).ne'
  exact dvd_hPart_iff hN (hPart_dvd_24 _) (dvd_trans (hPart_sq_dvd hm0) (mPart_dvd N p))

theorem hPart_mPart_two (N : ℕ) : hPart (mPart N 2) = 2 ^ min 3 (N.factorization 2 / 2) := by
  simp [hPart, mPart, Nat.prime_two.factorization_pow]

theorem hPart_mPart_three (N : ℕ) : hPart (mPart N 3) = 3 ^ min 1 (N.factorization 3 / 2) := by
  simp [hPart, mPart, Nat.prime_three.factorization_pow]

theorem hPart_eq_mul (N : ℕ) : hPart N = hPart (mPart N 2) * hPart (mPart N 3) := by
  rw [hPart_mPart_two, hPart_mPart_three]
  rfl

/-- [S_{h(m_p)}] ∈ H for every prime p (it is trivial for p ∤ N). -/
theorem S_loc_mem (N p : ℕ) [NeZero N] (hp : p.Prime) :
    (QuotientGroup.mk ⟨S (hPart (mPart N p)), S_mem_normalizer' (hPart_mPart_dvd N p)⟩ : B N) ∈
      Hloc N := by
  by_cases hpN : p ∈ N.primeFactors
  · exact localGens_subset hpN (Or.inr (B.isClassOf_mk _))
  · have h0 : N.factorization p = 0 :=
      Nat.factorization_eq_zero_of_not_dvd (fun hd => hpN (Nat.mem_primeFactors.2 ⟨hp, hd, NeZero.ne N⟩))
    have h1 : hPart (mPart N p) = 1 := by simp [mPart, h0, hPart]
    have h2 : S (hPart (mPart N p)) ∈ Gamma0R N := by rw [h1]; exact S_one_mem N
    rw [(B.mk_eq_one_iff _).2 h2]
    exact one_mem _

theorem sC_mem (N : ℕ) [NeZero N] : sC N ∈ Hloc N := by
  have hcop : Nat.Coprime (hPart (mPart N 2)) (hPart (mPart N 3)) := by
    rw [hPart_mPart_two, hPart_mPart_three]
    exact Nat.Coprime.pow _ _ (by norm_num)
  have hb := Int.gcd_eq_gcd_ab (hPart (mPart N 2)) (hPart (mPart N 3))
  rw [Int.gcd_natCast_natCast, hcop] at hb
  have hxy : Int.gcdB (hPart (mPart N 2)) (hPart (mPart N 3)) * (hPart (mPart N 3) : ℤ) +
      Int.gcdA (hPart (mPart N 2)) (hPart (mPart N 3)) * (hPart (mPart N 2) : ℤ) = 1 := by
    push_cast at hb
    linear_combination -hb
  have hS := S_mul_eq_zpow (hPart_pos _).ne' (hPart_pos _).ne' hxy
  rw [← hPart_eq_mul] at hS
  have e : (⟨S (hPart N), S_h_mem N⟩ : Norm0 N) =
      ⟨S (hPart (mPart N 2)), S_mem_normalizer' (hPart_mPart_dvd N 2)⟩ ^
          Int.gcdB (hPart (mPart N 2)) (hPart (mPart N 3)) *
        ⟨S (hPart (mPart N 3)), S_mem_normalizer' (hPart_mPart_dvd N 3)⟩ ^
          Int.gcdA (hPart (mPart N 2)) (hPart (mPart N 3)) :=
    Subtype.ext hS
  unfold sC
  rw [e, QuotientGroup.mk_mul, QuotientGroup.mk_zpow, QuotientGroup.mk_zpow]
  exact mul_mem (zpow_mem (S_loc_mem N 2 Nat.prime_two) _) (zpow_mem (S_loc_mem N 3 Nat.prime_three) _)

/-! ### Atkin–Lehner classes -/

theorem isALClass_mk {N Q : ℕ} [NeZero N] (hQ : Q ∣ N) {g : SL(2, ℝ)} (hg : IsAtkinLehner N Q g) :
    B.IsALClass (QuotientGroup.mk ⟨g, isAtkinLehner_mem_normalizer' hQ hg⟩ : B N) Q := by
  refine ⟨⟨g, hg⟩, fun g' hg' => ⟨isAtkinLehner_mem_normalizer' hQ hg', ?_⟩⟩
  rw [B.mk_eq_mk_iff]
  exact (mul_inv_mem_iff_inv_mul_mem (isAtkinLehner_mem_normalizer' hQ hg)).1
    (isAtkinLehner_mul_inv_mem' hQ hg hg')

theorem AL_loc_mem {N p : ℕ} [NeZero N] (hp : p ∈ N.primeFactors) {g : SL(2, ℝ)}
    (hg : IsAtkinLehner N (mPart N p) g) :
    (QuotientGroup.mk ⟨g, isAtkinLehner_mem_normalizer' (mPart_dvd N p) hg⟩ : B N) ∈ Hloc N :=
  localGens_subset hp (Or.inl (isALClass_mk (mPart_dvd N p) hg))

theorem exists_AL_loc {N p : ℕ} [NeZero N] (hp : p.Prime) : ∃ g, IsAtkinLehner N (mPart N p) g :=
  exists_isAtkinLehner' (mPart_dvd N p)
    (Nat.Coprime.pow_left _ (Nat.coprime_ordCompl hp (NeZero.ne N)))

theorem prod_mPart_eq {N : ℕ} (hN : N ≠ 0) : ∏ p ∈ N.primeFactors, mPart N p = N := by
  conv_rhs => rw [← Nat.prod_factorization_pow_eq_self hN]
  rw [Nat.prod_factorization_eq_prod_primeFactors]
  rfl

theorem prod_mPart_dvd {N : ℕ} (hN : N ≠ 0) {T : Finset ℕ} (hT : T ⊆ N.primeFactors) :
    ∏ p ∈ T, mPart N p ∣ N := by
  have h := Finset.prod_dvd_prod_of_subset T N.primeFactors (fun p => mPart N p) hT
  rwa [prod_mPart_eq hN] at h

theorem AL_prod_mem {N : ℕ} [NeZero N] {T : Finset ℕ} (hT : T ⊆ N.primeFactors) :
    ∃ g, ∃ hg : IsAtkinLehner N (∏ p ∈ T, mPart N p) g,
      (QuotientGroup.mk ⟨g, isAtkinLehner_mem_normalizer' (prod_mPart_dvd (NeZero.ne N) hT) hg⟩
        : B N) ∈ Hloc N := by
  induction T using Finset.induction_on with
  | empty =>
    refine ⟨1, ⟨1, 0, 0, 1, by simp, ?_⟩, ?_⟩
    · ext i j; fin_cases i <;> fin_cases j <;> simp
    · exact one_mem _
  | insert p T hpT ih =>
    have hT' : T ⊆ N.primeFactors := fun q hq => hT (Finset.mem_insert_of_mem hq)
    have hp : p ∈ N.primeFactors := hT (Finset.mem_insert_self p T)
    obtain ⟨g₁, hg₁, hH₁⟩ := ih hT'
    obtain ⟨g₂, hg₂⟩ := exists_AL_loc (N := N) (Nat.prime_of_mem_primeFactors hp)
    have hdvd : mPart N p * ∏ q ∈ T, mPart N q ∣ N := by
      rw [← Finset.prod_insert hpT]; exact prod_mPart_dvd (NeZero.ne N) hT
    have h12 := isAtkinLehner_mul hdvd hg₂ hg₁
    rw [← Finset.prod_insert hpT] at h12
    exact ⟨g₂ * g₁, h12, mul_mem (AL_loc_mem hp hg₂) hH₁⟩

theorem fricke_mem_Norm0 (N : ℕ) [NeZero N] : fricke N (NeZero.ne N) ∈ Norm0 N :=
  isAtkinLehner_mem_normalizer' dvd_rfl (fricke_isAtkinLehner N (NeZero.ne N))

theorem fricke_mem (N : ℕ) [NeZero N] :
    (QuotientGroup.mk ⟨fricke N (NeZero.ne N), fricke_mem_Norm0 N⟩ : B N) ∈ Hloc N := by
  obtain ⟨g, hg, hH⟩ := AL_prod_mem (N := N) subset_rfl
  have hg' : IsAtkinLehner N N g := by rwa [prod_mPart_eq (NeZero.ne N)] at hg
  have hW := fricke_isAtkinLehner N (NeZero.ne N)
  have : (QuotientGroup.mk ⟨fricke N (NeZero.ne N), fricke_mem_Norm0 N⟩ : B N) =
      QuotientGroup.mk ⟨g, isAtkinLehner_mem_normalizer' dvd_rfl hg'⟩ := by
    rw [B.mk_eq_mk_iff]
    exact (mul_inv_mem_iff_inv_mul_mem (fricke_mem_Norm0 N)).1
      (isAtkinLehner_mul_inv_mem' dvd_rfl hW hg')
  rw [this]
  exact hH

/-- R = w_N S_h⁻¹ w_N⁻¹. -/
theorem Rmat_eq (N : ℕ) [NeZero N] :
    Rmat N = fricke N (NeZero.ne N) * (S (hPart N))⁻¹ * (fricke N (NeZero.ne N))⁻¹ := by
  have hN0 : (N : ℝ) ≠ 0 := Nat.cast_ne_zero.2 (NeZero.ne N)
  have hh0 : (hPart N : ℝ) ≠ 0 := Nat.cast_ne_zero.2 (hPart_pos N).ne'
  have hs : Real.sqrt N * Real.sqrt N = N := Real.mul_self_sqrt (Nat.cast_nonneg _)
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul, coe_S_inv,
    coe_inv_of_coe_eq_smul (coe_fricke N (NeZero.ne N)), coe_fricke]
  refine (smul_mul_mul_smul_eq hs hN0 ?_).symm
  rw [mul_fin_two, mul_fin_two]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Rmat] <;> field_simp

theorem rC_mem (N : ℕ) [NeZero N] : rC N ∈ Hloc N := by
  have e : (⟨Rmat N, Rmat_mem N⟩ : Norm0 N) =
      ⟨fricke N (NeZero.ne N), fricke_mem_Norm0 N⟩ * (⟨S (hPart N), S_h_mem N⟩ : Norm0 N)⁻¹ *
        (⟨fricke N (NeZero.ne N), fricke_mem_Norm0 N⟩ : Norm0 N)⁻¹ :=
    Subtype.ext (Rmat_eq N)
  unfold rC
  rw [e, QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_inv, QuotientGroup.mk_inv]
  exact mul_mem (mul_mem (fricke_mem N) (inv_mem (sC_mem N))) (inv_mem (fricke_mem N))

theorem CN_le_Hloc (N : ℕ) [NeZero N] : CN N ≤ Hloc N := by
  rw [CN_eq_closure, Subgroup.closure_le]
  rintro x (rfl | rfl)
  · exact sC_mem N
  · exact rC_mem N

/-! ### σ(H) is everything -/

theorem nPart_dvd (N : ℕ) [NeZero N] : nPart N ∣ N :=
  ⟨hPart N ^ 2, (hPart_sq_mul_nPart N (NeZero.ne N)).symm⟩

theorem sigmaB_AL {N p : ℕ} [NeZero N] (hp : p ∈ N.primeFactors) {g : SL(2, ℝ)}
    (hg : IsAtkinLehner N (mPart N p) g) :
    sigmaB N (QuotientGroup.mk ⟨g, isAtkinLehner_mem_normalizer' (mPart_dvd N p) hg⟩) =
      fun q : (nPart N).primeFactors =>
        Multiplicative.ofAdd (if (q : ℕ) = p then (1 : ZMod 2) else 0) := by
  funext q
  change Multiplicative.ofAdd (chi N q g) = _
  congr 1
  unfold chi
  have hpp := Nat.prime_of_mem_primeFactors hp
  have hq := Nat.prime_of_mem_primeFactors q.2
  rw [eOf_isAtkinLehner hpp hg]
  by_cases hqp : (q : ℕ) = p
  · have hqn : 0 < (nPart N).factorization q :=
      hq.factorization_pos_of_dvd (nPart_ne_zero N) (Nat.dvd_of_mem_primeFactors q.2)
    rw [if_pos hqp, if_pos]
    rw [← hqp]
    exact dvd_pow_self _ hqn.ne'
  · rw [if_neg hqp, if_neg]
    intro hd
    exact hqp ((Nat.prime_dvd_prime_iff_eq hq hpp).1 (hq.dvd_of_dvd_pow hd))

theorem exists_sigmaB_eq (N : ℕ) [NeZero N] (f : (nPart N).primeFactors → Multiplicative (ZMod 2)) :
    ∃ y ∈ Hloc N, sigmaB N y = f := by
  suffices f ∈ (Hloc N).map (sigmaB N) by
    obtain ⟨y, hy, rfl⟩ := this
    exact ⟨y, hy, rfl⟩
  rw [← Finset.univ_prod_mulSingle f]
  refine Subgroup.prod_mem _ (fun q _ => ?_)
  have hqN : (q : ℕ) ∈ N.primeFactors := Nat.primeFactors_mono (nPart_dvd N) (NeZero.ne N) q.2
  obtain ⟨g, hg⟩ := exists_AL_loc (N := N) (Nat.prime_of_mem_primeFactors hqN)
  have hσ := sigmaB_AL hqN hg
  have hsingle : Pi.mulSingle q (Multiplicative.ofAdd (1 : ZMod 2)) =
      fun r : (nPart N).primeFactors =>
        Multiplicative.ofAdd (if (r : ℕ) = q then (1 : ZMod 2) else 0) := by
    funext r
    by_cases hr : r = q
    · subst hr; simp
    · have : (r : ℕ) ≠ q := fun h => hr (Subtype.ext h)
      simp [hr, this]
  have h01 : f q = 1 ∨ f q = Multiplicative.ofAdd 1 := by
    generalize f q = t
    obtain ⟨u, rfl⟩ : ∃ u : ZMod 2, Multiplicative.ofAdd u = t := ⟨Multiplicative.toAdd t, rfl⟩
    fin_cases u
    · left; rfl
    · right; rfl
  rcases h01 with h | h
  · rw [h, Pi.mulSingle_one]
    exact one_mem _
  · rw [h, hsingle, ← hσ]
    exact ⟨_, AL_loc_mem hqN hg, rfl⟩

/-- **T4.** -/
theorem closure_localGens' (N : ℕ) [NeZero N] :
    Subgroup.closure (⋃ p ∈ N.primeFactors, localGens N p) = ⊤ := by
  rw [eq_top_iff]
  intro x _
  obtain ⟨y, hy, hσ⟩ := exists_sigmaB_eq N (sigmaB N x)
  have hk : y⁻¹ * x ∈ CN N := by
    rw [← sigmaB_ker, MonoidHom.mem_ker, map_mul, map_inv, hσ]
    exact inv_mul_cancel _
  have := mul_mem hy (CN_le_Hloc N hk)
  rwa [mul_inv_cancel_left] at this

end

end NormalizerLean
