theorem normG_level_form {N : ℕ} [NeZero N] {Γ : Subgroup SL(2, ℤ)}
    (hΓ : CongruenceSubgroup.Gamma N ≤ Γ) {g : SL(2, ℝ)} (hg : g ∈ NormG (toR Γ)) :
