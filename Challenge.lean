-- Part 5, moved verbatim from `NormalizerDelta/DefsCartan.lean`.

/-!
# Cartan modular curves (2026-10-10): definitions

The groups Γ_H = {γ ∈ SL₂(ℤ) : γ mod N ∈ H} (they depend only on H ∩ SL₂(ℤ/N)) of the split and non-split Cartan
subgroups H and of their normalizers, defined by congruence conditions on the entries of γ = [[a, b], [c, d]]:
* Γ_sp(N): γ ≡ [[*, 0], [0, *]] mod N (C_sp = diagonal matrices);
* Γ_sp⁺(N): γ ≡ [[*, 0], [0, *]] or [[0, *], [*, 0]] mod N (diagonal or antidiagonal; for N = p an odd prime this is
  the normalizer C_sp⁺(p) of C_sp(p); for composite N it is in general a proper subgroup of the normalizer, and the
  statements use it only at prime level);
* Γ_ns(N, ε): γ ≡ [[a, εc], [c, a]] mod N (C_ns = {[[x, εy], [y, x]]}, the non-split Cartan subgroup when N = p is
  an odd prime and ε is not a square mod p, i.e. F_p[√ε]^× in the basis 1, √ε);
* Γ_ns⁺(N, ε): γ ≡ [[a, εc], [c, a]] or [[a, −εc], [c, −a]] mod N (C_ns⁺ = C_ns ∪ C_ns·diag(1, −1)).
Different non-squares ε give SL₂(ℤ)-conjugate groups.  Convention: Dose–Lido–Mercuri (arXiv:2005.09009) define Γ_H
with a transpose, so their Γ_{C_ns(ξ)} is `GammaNs p ξ⁻¹` here.
The curves are X_sp(N), X_sp⁺(N), X_ns(p), X_ns⁺(p); as before their modular automorphism groups are
`BG (toR Γ)` (all four groups contain −1).  `NormalizerDelta/Defs.lean` and all earlier statements are unchanged.
-/

open Matrix MatrixGroups

namespace NormalizerLean

noncomputable section

/-- The entries of γ⁻¹ = adj γ for γ ∈ SL₂(ℤ). -/
theorem SL2Z_inv_apply (γ : SL(2, ℤ)) :
    (γ⁻¹ : SL(2, ℤ)) 0 0 = γ 1 1 ∧ (γ⁻¹ : SL(2, ℤ)) 0 1 = -γ 0 1 ∧ (γ⁻¹ : SL(2, ℤ)) 1 0 = -γ 1 0 ∧
      (γ⁻¹ : SL(2, ℤ)) 1 1 = γ 0 0 := by
  simp [Matrix.SpecialLinearGroup.coe_inv, adjugate_fin_two]

/-- Γ_sp(N) = {γ ∈ SL₂(ℤ) : γ ≡ diagonal mod N}. -/
def GammaSp (N : ℕ) : Subgroup SL(2, ℤ) where
  carrier := {γ | ((γ 0 1 : ℤ) : ZMod N) = 0 ∧ ((γ 1 0 : ℤ) : ZMod N) = 0}
  one_mem' := by simp
  mul_mem' := by
    rintro γ γ' ⟨hb, hc⟩ ⟨hb', hc'⟩
    simp only [Set.mem_ofPred_eq, Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply,
      Fin.sum_univ_two, Int.cast_add, Int.cast_mul, hb, hc, hb', hc', mul_zero, zero_mul, add_zero,
      zero_add, and_self]
  inv_mem' := by
    rintro γ ⟨hb, hc⟩
    simp [Matrix.SpecialLinearGroup.coe_inv, adjugate_fin_two, hb, hc]

/-- Γ_sp⁺(N) = {γ ∈ SL₂(ℤ) : γ ≡ diagonal or antidiagonal mod N} (the normalizer of the split Cartan for N an odd
prime). -/
def GammaSpPlus (N : ℕ) : Subgroup SL(2, ℤ) where
  carrier := {γ | (((γ 0 1 : ℤ) : ZMod N) = 0 ∧ ((γ 1 0 : ℤ) : ZMod N) = 0) ∨
    (((γ 0 0 : ℤ) : ZMod N) = 0 ∧ ((γ 1 1 : ℤ) : ZMod N) = 0)}
  one_mem' := Or.inl (by simp)
  mul_mem' := by
    rintro γ γ' (⟨hb, hc⟩ | ⟨ha, hd⟩) (⟨hb', hc'⟩ | ⟨ha', hd'⟩)
    · left
      simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two, Int.cast_add,
        Int.cast_mul, hb, hc, hb', hc', mul_zero, zero_mul, add_zero, and_self]
    · right
      simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two, Int.cast_add,
        Int.cast_mul, hb, hc, ha', hd', mul_zero, zero_mul, add_zero, and_self]
    · right
      simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two, Int.cast_add,
        Int.cast_mul, ha, hd, hb', hc', mul_zero, zero_mul, add_zero, and_self]
    · left
      simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two, Int.cast_add,
        Int.cast_mul, ha, hd, ha', hd', mul_zero, zero_mul, add_zero, and_self]
  inv_mem' := by
    rintro γ (⟨hb, hc⟩ | ⟨ha, hd⟩)
    · exact Or.inl (by simp [Matrix.SpecialLinearGroup.coe_inv, adjugate_fin_two, hb, hc])
    · exact Or.inr (by simp [Matrix.SpecialLinearGroup.coe_inv, adjugate_fin_two, ha, hd])

/-- Γ_ns(N, ε) = {γ ∈ SL₂(ℤ) : γ ≡ [[a, εc], [c, a]] mod N}. -/
def GammaNs (N : ℕ) (ε : ZMod N) : Subgroup SL(2, ℤ) where
  carrier := {γ | ((γ 1 1 : ℤ) : ZMod N) = ((γ 0 0 : ℤ) : ZMod N) ∧
    ((γ 0 1 : ℤ) : ZMod N) = ε * ((γ 1 0 : ℤ) : ZMod N)}
  one_mem' := by simp
  mul_mem' := by
    rintro γ γ' ⟨hd, hb⟩ ⟨hd', hb'⟩
    simp only [Set.mem_ofPred_eq, Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply,
      Fin.sum_univ_two, Int.cast_add, Int.cast_mul, hd, hb, hd', hb']
    constructor <;> ring
  inv_mem' := by
    rintro γ ⟨hd, hb⟩
    obtain ⟨e00, e01, e10, e11⟩ := SL2Z_inv_apply γ
    show (((γ⁻¹ : SL(2, ℤ)) 1 1 : ℤ) : ZMod N) = _ ∧ _
    rw [e00, e01, e10, e11]
    push_cast
    exact ⟨by linear_combination -hd, by linear_combination -hb⟩

/-- Γ_ns⁺(N, ε) = {γ ∈ SL₂(ℤ) : γ ≡ [[a, εc], [c, a]] or [[a, −εc], [c, −a]] mod N}. -/
def GammaNsPlus (N : ℕ) (ε : ZMod N) : Subgroup SL(2, ℤ) where
  carrier := {γ | (((γ 1 1 : ℤ) : ZMod N) = ((γ 0 0 : ℤ) : ZMod N) ∧
      ((γ 0 1 : ℤ) : ZMod N) = ε * ((γ 1 0 : ℤ) : ZMod N)) ∨
    (((γ 1 1 : ℤ) : ZMod N) = -((γ 0 0 : ℤ) : ZMod N) ∧
      ((γ 0 1 : ℤ) : ZMod N) = -(ε * ((γ 1 0 : ℤ) : ZMod N)))}
  one_mem' := Or.inl (by simp)
  mul_mem' := by
    rintro γ γ' (⟨hd, hb⟩ | ⟨hd, hb⟩) (⟨hd', hb'⟩ | ⟨hd', hb'⟩) <;>
    simp only [Set.mem_ofPred_eq, Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply,
      Fin.sum_univ_two, Int.cast_add, Int.cast_mul, hd, hb, hd', hb']
    · exact Or.inl ⟨by ring, by ring⟩
    · exact Or.inr ⟨by ring, by ring⟩
    · exact Or.inr ⟨by ring, by ring⟩
    · exact Or.inl ⟨by ring, by ring⟩
  inv_mem' := by
    rintro γ h
    obtain ⟨e00, e01, e10, e11⟩ := SL2Z_inv_apply γ
    show ((((γ⁻¹ : SL(2, ℤ)) 1 1 : ℤ) : ZMod N) = _ ∧ _) ∨ _
    rw [e00, e01, e10, e11]
    push_cast
    rcases h with ⟨hd, hb⟩ | ⟨hd, hb⟩
    · exact Or.inl ⟨by linear_combination -hd, by linear_combination -hb⟩
    · exact Or.inr ⟨by linear_combination hd, by linear_combination -hb⟩

end

end NormalizerLean

-- Part 6, moved verbatim from `NormalizerDelta/DefsGeneral.lean`.

/-!
# General modular curves (2026-10-10): definitions

Definitions for `StatementsGeneral.lean`.  A modular curve of level N is X_H = Γ_H\ℍ* for a subgroup H ≤ SL₂(ℤ/N),
Γ_H = {γ ∈ SL₂(ℤ) : γ mod N ∈ H}.  (For H ≤ GL₂(ℤ/N) with det H = (ℤ/N)ˣ, as in Dose–Lido–Mercuri,
arXiv:2610.08998, Γ_H only depends on H ∩ SL₂(ℤ/N); every congruence subgroup Γ ⊇ Γ(N) is a Γ_H,
`GammaH_map`.)  The statements are about `BG (toR (GammaH N H))` = Nor(Γ_H)/Γ_H.  For −1 ∈ H this is the modular
automorphism group of X_H; for −1 ∉ H the curve's group is the one for H ⊔ {±1} (as for Γ(N) and Γ₁(N) in
`NormalizerDelta/Defs.lean`).

The local conditions are about the reduction of H modulo q ∣ N, computed entrywise with `ZMod.cast`
(for q ∣ N this is the reduction map ℤ/N → ℤ/q; the statements only use it for q ∣ N, or where q ∣ N follows
from the other hypotheses):
* `FixesLine H q v`: every h ∈ H maps v ∈ (ℤ/q)² to a multiple of v;
* `IsBorelMod H q`: H mod q lies in a Borel subgroup, i.e. fixes the line spanned by a unimodular vector
  (for q = p^k: a vector with v mod p ≠ 0);
* `IsSplitMod H q`: H mod q lies in a split Cartan subgroup, i.e. fixes the lines spanned by v and w with
  det [v w] a unit (equivalently: H mod q is conjugate in GL₂(ℤ/q) into the diagonal matrices);
* `FixesUniqueLine H` (prime level): H fixes exactly one line of F_p².
`NormalizerDelta/Defs.lean` and all earlier definitions and statements are unchanged.
-/

open Matrix MatrixGroups

namespace NormalizerLean

noncomputable section

/-- Γ_H = {γ ∈ SL₂(ℤ) : γ mod N ∈ H}, for H ≤ SL₂(ℤ/N). -/
def GammaH (N : ℕ) (H : Subgroup SL(2, ZMod N)) : Subgroup SL(2, ℤ) := H.comap (redSL N)

/-- The normalizer N(H) of H in SL₂(ℤ/N). -/
abbrev NormH {N : ℕ} (H : Subgroup SL(2, ZMod N)) : Subgroup SL(2, ZMod N) :=
  Subgroup.normalizer (H : Set SL(2, ZMod N))

instance {N : ℕ} (H : Subgroup SL(2, ZMod N)) : (H.subgroupOf (NormH H)).Normal :=
  Subgroup.normal_in_normalizer

/-- N(H)/H. -/
abbrev QH {N : ℕ} (H : Subgroup SL(2, ZMod N)) : Type := NormH H ⧸ H.subgroupOf (NormH H)

/-- H mod q fixes the line through v ∈ (ℤ/q)²: for every h ∈ H, (h mod q) v ∈ (ℤ/q)·v. -/
def FixesLine {N : ℕ} (H : Subgroup SL(2, ZMod N)) (q : ℕ) (v : Fin 2 → ZMod q) : Prop :=
  ∀ h ∈ H, ∃ c : ZMod q,
    (h : Matrix (Fin 2) (Fin 2) (ZMod N)).map (ZMod.cast : ZMod N → ZMod q) *ᵥ v = c • v

/-- H mod q lies in a Borel subgroup of GL₂(ℤ/q): it fixes the line through a unimodular v
(a v₀ + b v₁ = 1 for some a, b). -/
def IsBorelMod {N : ℕ} (H : Subgroup SL(2, ZMod N)) (q : ℕ) : Prop :=
  ∃ v : Fin 2 → ZMod q, (∃ a b : ZMod q, a * v 0 + b * v 1 = 1) ∧ FixesLine H q v

/-- H mod q lies in a split Cartan subgroup of GL₂(ℤ/q): it fixes the lines through v and w, where
det [v w] = v₀w₁ − v₁w₀ is a unit. -/
def IsSplitMod {N : ℕ} (H : Subgroup SL(2, ZMod N)) (q : ℕ) : Prop :=
  ∃ v w : Fin 2 → ZMod q, FixesLine H q v ∧ FixesLine H q w ∧ IsUnit (v 0 * w 1 - v 1 * w 0)

/-- H ≤ SL₂(ℤ/p) fixes exactly one line of (ℤ/p)² (used for p prime). -/
def FixesUniqueLine {p : ℕ} (H : Subgroup SL(2, ZMod p)) : Prop :=
  ∃ v : Fin 2 → ZMod p, v ≠ 0 ∧ FixesLine H p v ∧ ∀ w, FixesLine H p w → ∃ c : ZMod p, w = c • v

/-- The Fricke involution W_p = (1/√p)·[[0, −1], [p, 0]] ∈ SL₂(ℝ). -/
def frickeP (p : ℕ) : SL(2, ℝ) := projSL !![0, -1; (p : ℝ), 0]

end

end NormalizerLean

/-! # From `NormalizerLean/Statements.lean` (proofs replaced by `sorry`) -/

/-!
# B(N) = Norm_{SL₂(ℝ)}(Γ₀(N)) / Γ₀(N): definitions and main statements

This file states T1–T8 of the handover note
`~/automorphisms_X1/notes/2026-10-02-lean-BN-handover.md` (§4).  The definitions are in
`Defs.lean` (moved there verbatim from this file); the proofs live in the other files and are
imported through `Proofs.lean`.  Each theorem below is proved by applying its proof `X'`.  The
statements are unchanged since the user's review (commit 11358c3); no definition or statement
changes without the user's approval.

Blueprint references (paths relative to `~/automorphisms_X1/audit/`):
* [Nw]  `newman_normalizer.md`
* [BA]  `bars_all_levels.md`
* [BAu] `bars_audit.md`

Conventions.
* `B N` is defined honestly as a quotient of the normalizer in SL₂(ℝ); no statement uses a
  presented group as a definition of `B N`.
* An element of `B N` is tied to a real matrix by `B.IsClassOf x g`, which asserts that `g`
  normalizes Γ₀(N) and that `x` is its coset.  So no statement silently assumes membership.
* Atkin–Lehner elements are handled through the predicate `IsAtkinLehner N Q g` (all choices of
  x, y, z, w at once), not through one hard-wired choice of Bézout coefficients.
* `[x, y] = x⁻¹ y⁻¹ x y` (the blueprint's convention, `bracket` below).  Mathlib's `⁅x, y⁆` is
  `x y x⁻¹ y⁻¹`; it is not used.
-/

open Matrix MatrixGroups

namespace NormalizerLean

noncomputable section

/-! ## T1: explicit elements of the normalizer -/

/-- h(N) is the largest divisor of 24 whose square divides N. -/
theorem hPart_isGreatest (N : ℕ) [NeZero N] :
    IsGreatest {d : ℕ | d ∣ 24 ∧ d ^ 2 ∣ N} (hPart N) := sorry

/-- **T1** for Atkin–Lehner elements: every w_Q with Q ∣ N normalizes Γ₀(N).
(`hQ` is essential; see `IsAtkinLehner`.) -/
theorem isAtkinLehner_mem_normalizer {N Q : ℕ} [NeZero N] (hQ : Q ∣ N) {g : SL(2, ℝ)}
    (hg : IsAtkinLehner N Q g) : g ∈ Norm0 N := sorry

/-- Atkin–Lehner elements exist for every exact divisor Q ∥ N. -/
theorem exists_isAtkinLehner {N Q : ℕ} [NeZero N] (hQ : Q ∣ N) (hcop : Nat.Coprime Q (N / Q)) :
    ∃ g, IsAtkinLehner N Q g := sorry

/-- Any two Atkin–Lehner elements for Q differ by an element of Γ₀(N), so w_Q ∈ B(N) is
well defined. -/
theorem isAtkinLehner_mul_inv_mem {N Q : ℕ} [NeZero N] (hQ : Q ∣ N) {g g' : SL(2, ℝ)}
    (hg : IsAtkinLehner N Q g) (hg' : IsAtkinLehner N Q g') : g * g'⁻¹ ∈ Gamma0R N := sorry

/-- **T1** for translations: S_k normalizes Γ₀(N) for every k ∣ h(N); in particular S_h does. -/
theorem S_mem_normalizer {N k : ℕ} [NeZero N] (hk : k ∣ hPart N) : S k ∈ Norm0 N := sorry

/-- **T1** in general [Nw §1]: every matrix of the form (8′) normalizes Γ₀(N). -/
theorem newmanForm_mem_normalizer {N : ℕ} [NeZero N] {g : SL(2, ℝ)} (hg : IsNewmanForm N g) :
    g ∈ Norm0 N := sorry

/-! ## T2: Newman's theorem -/

/-- **T2** (Newman) [Nw §§2–8]: every element of the normalizer has the form (8′). -/
theorem newman {N : ℕ} [NeZero N] {g : SL(2, ℝ)} (hg : g ∈ Norm0 N) : IsNewmanForm N g := sorry

/-! ## T3: the order of B(N) -/

/-- The index formula μ(t) = [SL₂(ℤ) : Γ₀(t)] = t ∏_{p ∣ t} (1 + 1/p). -/
theorem Gamma0_index (t : ℕ) [NeZero t] :
    ((CongruenceSubgroup.Gamma0 t).index : ℚ) = psi t := sorry

/-- **T3**: B(N) is finite. -/
theorem finite_B (N : ℕ) [NeZero N] : Finite (B N) := sorry

/-- **T3**: |B(N)| = 2^{ω(n)} μ(N)/μ(n). -/
theorem card_B (N : ℕ) [NeZero N] :
    (Nat.card (B N) : ℚ) = 2 ^ (nPart N).primeFactors.card * psi N / psi (nPart N) := sorry

/-- **T3**, explicit form: for N = 2ᵃ 3ᵇ M with gcd(M, 6) = 1, |B(N)| = f₂(a) f₃(b) 2^{ω(M)}. -/
theorem card_B_explicit (N : ℕ) [NeZero N] :
    Nat.card (B N) =
      f₂ (N.factorization 2) * f₃ (N.factorization 3) * 2 ^ (N.primeFactors \ {2, 3}).card := sorry

/-- D⁻¹ Γ₀(n) D ⊆ Norm(Γ₀(N)), so `CN N` is literally D⁻¹ Γ₀(n) D / Γ₀(N).  (The e = 1 case of T1.) -/
theorem conjGamma0n_le_normalizer (N : ℕ) [NeZero N] : conjGamma0n N ≤ Norm0 N := sorry

/-- |C(N)| = μ(N)/μ(n). -/
theorem card_CN (N : ℕ) [NeZero N] : (Nat.card (CN N) : ℚ) = psi N / psi (nPart N) := sorry

/-- B(N)/C(N) ≅ (ℤ/2)^{ω(n)} [Nw §9], stated as: a surjection onto (ℤ/2)^{primes of n}
with kernel C(N). -/
theorem B_mod_CN (N : ℕ) [NeZero N] :
    ∃ σ : B N →* ((nPart N).primeFactors → Multiplicative (ZMod 2)),
      Function.Surjective σ ∧ σ.ker = CN N := sorry

/-! ## T4: generation -/

/-- **T4** [BA]: B(N) is generated by the classes of w_{m_p} and S_{h(m_p)}, p ∣ N. -/
theorem closure_localGens (N : ℕ) [NeZero N] :
    Subgroup.closure (⋃ p ∈ N.primeFactors, localGens N p) = ⊤ := sorry

/-! ## T5: local presentations -/

/-- **T5** [BA, table and (4)–(7)]: for a prime power pᵃ, the local presentation is a presentation
of B(pᵃ), with w ↦ w_{pᵃ} and s ↦ S_{h(pᵃ)}. -/
theorem localPresentation (p a : ℕ) (hp : p.Prime) (ha : 0 < a) :
    ∃ φ : PresentedGroup (localRels p a) ≃* B (p ^ a),
      (φ (.of .w)).IsALClass (p ^ a) ∧ (φ (.of .s)).IsClassOf (S (hPart (p ^ a))) := sorry

/-! ## T6: the prime-power embedding and the global presentation -/

/-- **T6** [BA, (12)]: for p ∣ N, B_p = ⟨w_{m_p}, S_{h(m_p)}⟩ ≤ B(N) maps isomorphically onto
B(m_p) by "forgetting the extra level": the class of g mod Γ₀(N) goes to the class of g mod Γ₀(m_p). -/
theorem localEmbedding (N p : ℕ) [NeZero N] (hp : p ∈ N.primeFactors) :
    ∃ φ : Bloc N p ≃* B (mPart N p),
      ∀ (x : Bloc N p) (g : SL(2, ℝ)), (x : B N).IsClassOf g → (φ x).IsClassOf g := sorry

/-- **T6** [BA, (1)]: the global presentation is a presentation of B(N), with w_p ↦ w_{m_p} and
s_p ↦ S_{h(m_p)}. -/
theorem globalPresentation (N : ℕ) [NeZero N] :
    ∃ φ : PresentedGroup (globalRels N) ≃* B N, ∀ p : N.primeFactors,
      (φ (.of (p, .w))).IsALClass (mPart N p) ∧
        (φ (.of (p, .s))).IsClassOf (S (hPart (mPart N p))) := sorry

/-! ## T7: the direct-product criterion -/

/-- **T7** [BA, (3)]: the local subgroups B_p form an internal direct product (the product of the
inclusions is an isomorphism ∏_p B_p ≅ B(N)) iff m_p ≡ 1 (mod h(m_q)) for all p ≠ q. -/
theorem internalDirectProduct_iff (N : ℕ) [NeZero N] :
    (∃ φ : ((p : N.primeFactors) → Bloc N p) ≃* B N,
        ∀ (p : N.primeFactors) (x : Bloc N p), φ (Pi.mulSingle p x) = x) ↔
      ∀ p ∈ N.primeFactors, ∀ q ∈ N.primeFactors, p ≠ q →
        mPart N p ≡ 1 [MOD hPart (mPart N q)] := sorry

/-- **T7**, example: B(18) ≅ S₄. -/
theorem B18_equiv_perm : Nonempty (B 18 ≃* Equiv.Perm (Fin 4)) := sorry

/-- **T7**, example: B(18) is not C₂ × A₄. -/
theorem B18_not_C2_prod_A4 :
    IsEmpty (B 18 ≃* Multiplicative (ZMod 2) × alternatingGroup (Fin 4)) := sorry

/-! ## T8: the errors in the literature -/

/-- **T8(a)**, matrix identity [BAu §4]: with w = w₂₅₆ and s = S₈,
(w s² w s)(s² w s w)⁻¹ = [[5, −9/8], [−288, 65]]. -/
theorem AS_quotient_matrix :
    ((w256 * S 8 ^ 2 * w256 * S 8 * (S 8 ^ 2 * w256 * S 8 * w256)⁻¹ : SL(2, ℝ)) :
      Matrix (Fin 2) (Fin 2) ℝ) = !![5, -9 / 8; -288, 65] := sorry

/-- **T8(a)**: the Akbaş–Singerman relation w s² w s = s² w s w fails in B(256). -/
theorem AS_relation_fails :
    ∃ x y : B 256, x.IsClassOf w256 ∧ y.IsClassOf (S 8) ∧
      x * y ^ 2 * x * y ≠ y ^ 2 * x * y * x := sorry

/-- **T8(a)**, matrix identity [BAu §4]: w s w s w s³ w s³ = −[[11, 4], [−256, −93]]. -/
theorem bars_word_matrix :
    ((w256 * S 8 * w256 * S 8 * w256 * S 8 ^ 3 * w256 * S 8 ^ 3 : SL(2, ℝ)) :
      Matrix (Fin 2) (Fin 2) ℝ) = -!![11, 4; -256, -93] := sorry

/-- **T8(a)**: Bars's relation w s w s w s³ w s³ = 1 holds in B(256). -/
theorem bars_relation_holds :
    ∃ x y : B 256, x.IsClassOf w256 ∧ y.IsClassOf (S 8) ∧
      x * y * x * y * x * y ^ 3 * x * y ^ 3 = 1 := sorry

/-- **T8(b)**: Bars's presentation at λ = 5, Δ(2, 4, 4), is infinite. -/
theorem bars_lambda5_infinite : Infinite (PresentedGroup (barsRels 4 4)) := sorry

/-- **T8(b)**: Bars's presentation at λ = 6, Δ(2, 8, 3), is infinite. -/
theorem bars_lambda6_infinite : Infinite (PresentedGroup (barsRels 8 3)) := sorry

/-- **T8(b)**: Bars's presentation at λ = 7, Δ(2, 8, 4), is infinite. -/
theorem bars_lambda7_infinite : Infinite (PresentedGroup (barsRels 8 4)) := sorry

open Words in
/-- **T8(c)**: adding (w s⁻¹ w s)² = 1 at λ = 5 gives order 32. -/
theorem completed_lambda5_card :
    Nat.card (PresentedGroup (barsRels 4 4 ∪ {(w * s⁻¹ * w * s) ^ 2})) = 32 := sorry

open Words in
/-- **T8(c)**, stronger: the completed λ = 5 presentation presents B(32), w ↦ w₃₂, s ↦ S₄. -/
theorem completed_lambda5 :
    ∃ φ : PresentedGroup (barsRels 4 4 ∪ {(w * s⁻¹ * w * s) ^ 2}) ≃* B 32,
      (φ (.of .w)).IsALClass 32 ∧ (φ (.of .s)).IsClassOf (S 4) := sorry

open Words in
/-- **T8(c)**: adding (w s⁻¹ w s)³ = 1 at λ = 6 gives order 96. -/
theorem completed_lambda6_card :
    Nat.card (PresentedGroup (barsRels 8 3 ∪ {(w * s⁻¹ * w * s) ^ 3})) = 96 := sorry

open Words in
/-- **T8(c)**, stronger: the completed λ = 6 presentation presents B(64), w ↦ w₆₄, s ↦ S₈. -/
theorem completed_lambda6 :
    ∃ φ : PresentedGroup (barsRels 8 3 ∪ {(w * s⁻¹ * w * s) ^ 3}) ≃* B 64,
      (φ (.of .w)).IsALClass 64 ∧ (φ (.of .s)).IsClassOf (S 8) := sorry

open Words in
/-- **T8(d)**: Bars's λ = 8 presentation ⟨w, s | w², s⁸, w s w s w s³ w s³⟩ has order 128. -/
theorem bars_lambda8_card :
    Nat.card (PresentedGroup ({w ^ 2, s ^ 8, w * s * w * s * w * s ^ 3 * w * s ^ 3} :
      Set (FreeGroup LGen))) = 128 := sorry

open Words in
/-- **T8(d)**, stronger: Bars's λ = 8 presentation presents B(256), w ↦ w₂₅₆, s ↦ S₈. -/
theorem bars_lambda8 :
    ∃ φ : PresentedGroup ({w ^ 2, s ^ 8, w * s * w * s * w * s ^ 3 * w * s ^ 3} :
        Set (FreeGroup LGen)) ≃* B 256,
      (φ (.of .w)).IsALClass 256 ∧ (φ (.of .s)).IsClassOf (S 8) := sorry

/-! ## Stage-1 milestones (relations hold; consequences of T5/T6, proved first) -/

/-- The local relators hold in B(pᵃ): they evaluate into Γ₀(pᵃ) under w ↦ any Atkin–Lehner
element w_{pᵃ} and s ↦ S_{h(pᵃ)}.  This covers the relations of the table of [BA] and (4)–(7),
including the [r, s] = 1 cases of (14) (not the formula (14) itself). -/
theorem localRels_mem_Gamma0 (p a : ℕ) (hp : p.Prime) (ha : 0 < a) {wg : SL(2, ℝ)}
    (hw : IsAtkinLehner (p ^ a) (p ^ a) wg) :
    ∀ ρ ∈ localRels p a,
      FreeGroup.lift (fun x : LGen => match x with | .w => wg | .s => S (hPart (p ^ a))) ρ ∈
        Gamma0R (p ^ a) := sorry

/-- The global relators hold in B(N), for any choice of Atkin–Lehner elements w_{m_p}.
This covers (1) and (15) of [BA]. -/
theorem globalRels_mem_Gamma0 (N : ℕ) [NeZero N] (wg : N.primeFactors → SL(2, ℝ))
    (hw : ∀ p : N.primeFactors, IsAtkinLehner N (mPart N p) (wg p)) :
    ∀ ρ ∈ globalRels N,
      FreeGroup.lift (fun x : GGen N => match x.2 with
        | .w => wg x.1
        | .s => S (hPart (mPart N x.1))) ρ ∈ Gamma0R N := sorry

end

end NormalizerLean

/-! # From `NormalizerDelta/Statements.lean` (proofs replaced by `sorry`) -/

/-!
# Normalizers of Γ_Δ(N), Γ(N) and ±Γ₁(N): statements (Stage 0, all `sorry`)

Plan: `~/automorphisms_X1/notes/2026-10-08-lean-delta-plan.md`.  The definitions are in `NormalizerDelta/Defs.lean`; the B(N)
definitions (`Gamma0R`, `Norm0`, `IsAtkinLehner`, `IsNewmanForm`, `hPart`, `projSL`, `S`) are those
of `NormalizerLean/Defs.lean`, unchanged.

* §D: basic facts on Γ_Δ(N), the generalized Newman bound, sanity statements.
* §C: Nor(Γ_Δ(N)) ≤ Nor(Γ₀(N)) if h_Δ = h(N) (not in general: S₇ at level 49), and
  [Nor(Γ_Δ(N)) : Γ_Δ(N)] = i_Δ · s_Δ, with s_Δ = #{Q ∥ N : ι_Q(Δ) = Δ} if 4 ∤ N, 9 ∤ N.
* §G: Nor(Γ(N)) = SL₂(ℤ), and the modular automorphism group of X(N) is SL₂(ℤ/N)/{±1};
  X_Δ(N) ≅ X₁(M, N/M) for Δ = {±1 mod N/M} (X(M) for N = M²).
* §K: Kim–Koo / Lang: Nor(±Γ₁(N)) = ⟨Γ₀(N), w_Q⟩ for N ≠ 4, its order 2^{ω(N)} φ(N)/2 (N ≥ 3,
  N ≠ 4), and the diamond subgroup is normal with elementary abelian quotient; the exception N = 4.

These statements were reviewed in two rounds on 2026-10-08 (notes in `review/` of the development
repository).

No statement changes after the user's review without the user's approval.
-/

open Matrix MatrixGroups

namespace NormalizerLean

noncomputable section

/-! ## §D. Γ_Δ(N) and the generalized Newman bound -/

/-- Γ₀(N) normalizes Γ_Δ(N), for every Δ: the diamond operators act on X_Δ(N). -/
theorem Gamma0R_le_normG_GammaDeltaR (N : ℕ) (Δ : Subgroup (ZMod N)ˣ) :
    Gamma0R N ≤ NormG (GammaDeltaR N Δ) := sorry

/-- [Γ₀(N) : Γ_Δ(N)] = [(ℤ/N)ˣ : Δ] = i_Δ (for −1 ∈ Δ this is the degree of
X_Δ(N) → X₀(N)). -/
theorem relindex_GammaDelta (N : ℕ) [NeZero N] (Δ : Subgroup (ZMod N)ˣ) :
    (GammaDelta N Δ).relIndex (CongruenceSubgroup.Gamma0 N) = Δ.index := sorry

/-- Sanity: Δ = (ℤ/N)ˣ gives Γ₀(N). -/
theorem GammaDelta_top (N : ℕ) : GammaDelta N ⊤ = CongruenceSubgroup.Gamma0 N := sorry

/-- Sanity: Δ = {±1} gives ±Γ₁(N), with Mathlib's `CongruenceSubgroup.Gamma1`. -/
theorem GammaDelta_pmOne (N : ℕ) :
    GammaDelta N (pmOne N) = CongruenceSubgroup.Gamma1 N ⊔ Subgroup.zpowers (-1) := sorry

/-- Sanity: for Δ = (ℤ/N)ˣ, ε_Δ = gcd(N, 24). -/
theorem epsDelta_top (N : ℕ) [NeZero N] : epsDelta N ⊤ = Nat.gcd N 24 := sorry

/-- Sanity: for Δ = {±1}, ε_Δ = N. -/
theorem epsDelta_pmOne (N : ℕ) [NeZero N] : epsDelta N (pmOne N) = N := sorry

/-- Sanity: h(N) ∣ h_Δ. -/
theorem hPart_dvd_hDelta (N : ℕ) [NeZero N] (Δ : Subgroup (ZMod N)ˣ) :
    hPart N ∣ hDelta N Δ := sorry

/-- Sanity: h_Δ² ∣ N, so n_Δ = N / h_Δ² is an exact quotient. -/
theorem hDelta_sq_dvd (N : ℕ) [NeZero N] (Δ : Subgroup (ZMod N)ˣ) :
    hDelta N Δ ^ 2 ∣ N := sorry

/-- Sanity: for Δ = (ℤ/N)ˣ, h_Δ = h(N). -/
theorem hDelta_top (N : ℕ) [NeZero N] : hDelta N ⊤ = hPart N := sorry

/-- Sanity: with h = h(N) the form of `newman_delta` is Newman's form (8′). -/
theorem isNewmanFormH_hPart_iff (N : ℕ) (g : SL(2, ℝ)) :
    IsNewmanFormH N (hPart N) g ↔ IsNewmanForm N g := sorry

/-- **Generalized Newman bound**: every element of the normalizer of Γ_Δ(N) in
SL₂(ℝ) is ±(1/√e)·[[ae, b/h_Δ], [Nc/h_Δ, de]] with a, b, c, d ∈ ℤ, e ∣ n_Δ, ade² − bcn_Δ = e
(which forces e ∥ n_Δ).
For any subgroup Δ, not only for −1 ∈ Δ (note that Nor(Γ_Δ(N)) ≤ Nor(Γ_{±Δ}(N)) and
ε_{±Δ} = ε_Δ). -/
theorem newman_delta {N : ℕ} [NeZero N] (Δ : Subgroup (ZMod N)ˣ) {g : SL(2, ℝ)}
    (hg : g ∈ NormG (GammaDeltaR N Δ)) : IsNewmanFormH N (hDelta N Δ) g := sorry

/-- The bound is only a necessary condition: S₂ = [[1, 1/2], [0, 1]] has the form of `newman_delta` for
Δ = {±1}, N = 8 (h_Δ = 2), but does not normalize ±Γ₁(8). -/
theorem newman_delta_not_sufficient :
    IsNewmanFormH 8 (hDelta 8 (pmOne 8)) (S 2) ∧ S 2 ∉ NormG (GammaDeltaR 8 (pmOne 8)) := sorry

/-! ## §C. Nor(Γ_Δ(N)) ≤ Nor(Γ₀(N)), and the index -/

/-- If h_Δ = h(N), then Nor(Γ_Δ(N)) ≤ Nor(Γ₀(N)). -/
theorem normG_GammaDeltaR_le_Norm0 {N : ℕ} [NeZero N] (Δ : Subgroup (ZMod N)ˣ)
    (h : hDelta N Δ = hPart N) : NormG (GammaDeltaR N Δ) ≤ Norm0 N := sorry

/-- Without h_Δ = h(N) this fails: for N = 49 and
Δ = {d ≡ ±1 mod 7} (h_Δ = 7, h(49) = 1), S₇ = [[1, 1/7], [0, 1]] normalizes Γ_Δ(49) but not Γ₀(49). -/
theorem S7_mem_normG_GammaDeltaR_49 :
    S 7 ∈ NormG (GammaDeltaR 49 (deltaPm 49 7 (by norm_num))) ∧ S 7 ∉ Norm0 49 := sorry

/-- **The index**: if h_Δ = h(N), then [Nor(Γ_Δ(N)) : Γ_Δ(N)] = i_Δ · s_Δ, where
i_Δ = [(ℤ/N)ˣ : Δ] and s_Δ is the number of elements of B(N) normalizing Γ_Δ(N).
(For −1 ∈ Δ this is the order of the modular automorphism group of X_Δ(N); the
identity of indices holds for every Δ.) -/
theorem card_BG_GammaDeltaR {N : ℕ} [NeZero N] (Δ : Subgroup (ZMod N)ˣ)
    (h : hDelta N Δ = hPart N) : Nat.card (BG (GammaDeltaR N Δ)) = Δ.index * sDelta N Δ := sorry

/-- **The count s_Δ**: if 4 ∤ N and 9 ∤ N, then s_Δ = #{Q ∥ N : ι_Q(Δ) = Δ}, where
ι_Q(d) ≡ d⁻¹ mod Q and ι_Q(d) ≡ d mod N/Q.
Neither h_Δ = h(N) nor −1 ∈ Δ is assumed, on purpose: s_Δ counts elements of B(N) (not of
Nor(Γ_Δ(N))/Γ₀(N)); for 4 ∤ N, 9 ∤ N these are the classes of the w_Q, and
w_Q Γ_Δ(N) w_Q⁻¹ = Γ_{ι_Q(Δ)}(N) for every Δ.  (h_Δ = h(N) is needed only in `card_BG_GammaDeltaR`.) -/
theorem sDelta_eq_sIota {N : ℕ} [NeZero N] (Δ : Subgroup (ZMod N)ˣ) (h4 : ¬ 4 ∣ N) (h9 : ¬ 9 ∣ N) :
    sDelta N Δ = sIota N Δ := sorry

/-- **The index**, combined with `sDelta_eq_sIota`: if h_Δ = h(N), 4 ∤ N and 9 ∤ N, then
[Nor(Γ_Δ(N)) : Γ_Δ(N)] = i_Δ · #{Q ∥ N : ι_Q(Δ) = Δ}. -/
theorem card_BG_GammaDeltaR_of_not_dvd {N : ℕ} [NeZero N] (Δ : Subgroup (ZMod N)ˣ)
    (h : hDelta N Δ = hPart N) (h4 : ¬ 4 ∣ N) (h9 : ¬ 9 ∣ N) :
    Nat.card (BG (GammaDeltaR N Δ)) = Δ.index * sIota N Δ := sorry

/-! ## §G. Γ(N) and X(N) -/

/-- The normalizer of Γ(N) in SL₂(ℝ) is SL₂(ℤ), for every N ≥ 1. -/
theorem normG_GammaR (N : ℕ) [NeZero N] : NormG (GammaR N) = SL2ZR := sorry

/-- The normalizer of ±Γ(N) in SL₂(ℝ) is SL₂(ℤ), for every N ≥ 1. -/
theorem normG_pmGammaR (N : ℕ) [NeZero N] : NormG (pmGammaR N) = SL2ZR := sorry

/-- Nor(Γ(N))/Γ(N) ≅ SL₂(ℤ/N), the class of γ ∈ SL₂(ℤ) going to γ mod N.  (For N ≥ 3 this is a
double cover of the modular automorphism group of X(N); see `BG_pmGammaR_equiv`.) -/
theorem BG_GammaR_equiv (N : ℕ) [NeZero N] :
    ∃ φ : BG (GammaR N) ≃* SL(2, ZMod N),
      ∀ (γ : SL(2, ℤ)) (x : BG (GammaR N)), x.IsClassOf (ofZ γ) → φ x = redSL N γ := sorry

/-- **The modular automorphism group of X(N)**: Nor(±Γ(N))/±Γ(N) ≅ SL₂(ℤ/N)/{±1}, the class of
γ ∈ SL₂(ℤ) going to the class of γ mod N.  (For N ≤ 2, −1 ∈ Γ(N) and {±1} = 1, so this is the
same as `BG_GammaR_equiv`.) -/
theorem BG_pmGammaR_equiv (N : ℕ) [NeZero N] :
    ∃ φ : BG (pmGammaR N) ≃* SL(2, ZMod N) ⧸ pmOneSL N,
      ∀ (γ : SL(2, ℤ)) (x : BG (pmGammaR N)), x.IsClassOf (ofZ γ) →
        φ x = QuotientGroup.mk (redSL N γ) := sorry

/-- The case N = M² of `conj_GammaDelta_X1MN`: for
Δ = {d : d ≡ ±1 mod M}, conjugation by diag(M, 1) maps Γ_Δ(M²) onto ±Γ(M), so X_Δ(M²) ≅ X(M).
(`projSL` rescales diag(M, 1) to diag(√M, 1/√M) ∈ SL₂(ℝ), which conjugates in the same way:
[[a, b], [c, d]] ↦ [[a, Mb], [c/M, d]].  `0 < M` is needed: at M = 0 `projSL` has a junk value.) -/
theorem conj_GammaDelta_sq (M : ℕ) (hM : 0 < M) :
    (GammaDeltaR (M ^ 2) (deltaPm (M ^ 2) M (dvd_pow_self M two_ne_zero))).map
        (MulAut.conj (projSL !![(M : ℝ), 0; 0, 1])).toMonoidHom = pmGammaR M := sorry

/-- If M² ∣ N and
Δ = {d : d ≡ ±1 mod N/M}, conjugation by diag(M, 1) maps Γ_Δ(N) onto ±(Γ(M) ∩ Γ₁(N/M)), so
X_Δ(N) ≅ X₁(M, N/M).  (For N = M² this is `conj_GammaDelta_sq`, as Γ(M) ∩ Γ₁(M) = Γ(M).) -/
theorem conj_GammaDelta_X1MN {M N : ℕ} [NeZero N] (hM : 0 < M) (hMN : M ^ 2 ∣ N) :
    (GammaDeltaR N (deltaPm N (N / M)
        (Nat.div_dvd_of_dvd ((dvd_pow_self M two_ne_zero).trans hMN)))).map
        (MulAut.conj (projSL !![(M : ℝ), 0; 0, 1])).toMonoidHom =
      toR (CongruenceSubgroup.Gamma M ⊓ CongruenceSubgroup.Gamma1 (N / M)) ⊔
        Subgroup.zpowers (-1) := sorry

/-! ## §K. ±Γ₁(N) and X₁(N) -/

/-- Γ₀(N) normalizes ±Γ₁(N) (the diamond operators), for every N ≥ 1. -/
theorem Gamma0R_le_normG_pmGamma1R (N : ℕ) [NeZero N] : Gamma0R N ≤ NormG (pmGamma1R N) := sorry

/-- Every Atkin–Lehner element w_Q (Q ∣ N) normalizes ±Γ₁(N), for every N ≥ 1.
(`hQ` is essential, as for Γ₀(N): see `IsAtkinLehner`.) -/
theorem isAtkinLehner_mem_normG_pmGamma1R {N Q : ℕ} [NeZero N] (hQ : Q ∣ N) {g : SL(2, ℝ)}
    (hg : IsAtkinLehner N Q g) : g ∈ NormG (pmGamma1R N) := sorry

/-- **Kim–Koo, Lang**: for N ≠ 4 the normalizer of ±Γ₁(N) in SL₂(ℝ) is generated by Γ₀(N) and
the Atkin–Lehner elements.  Stated as a set: g normalizes ±Γ₁(N) iff g is an Atkin–Lehner element
w_Q for some Q ∥ N (Q = 1 gives Γ₀(N), by `isAtkinLehner_one_iff`).  The condition
`Nat.Coprime Q (N / Q)` is implied by `Q ∣ N` and `IsAtkinLehner N Q g`. -/
theorem normG_pmGamma1R {N : ℕ} [NeZero N] (hN : N ≠ 4) (g : SL(2, ℝ)) :
    g ∈ NormG (pmGamma1R N) ↔
      ∃ Q : ℕ, Q ∣ N ∧ Nat.Coprime Q (N / Q) ∧ IsAtkinLehner N Q g := sorry

/-- The case Q = 1 of `normG_pmGamma1R`: the Atkin–Lehner elements for Q = 1 are exactly Γ₀(N). -/
theorem isAtkinLehner_one_iff (N : ℕ) (g : SL(2, ℝ)) : IsAtkinLehner N 1 g ↔ g ∈ Gamma0R N := sorry

/-- The exception N = 4: ±Γ₁(4) = Γ₀(4). -/
theorem pmGamma1R_four : pmGamma1R 4 = Gamma0R 4 := sorry

/-- The exception N = 4: S₂ = [[1, 1/2], [0, 1]] normalizes ±Γ₁(4), but is not an Atkin–Lehner
element of level 4. -/
theorem S2_mem_normG_pmGamma1R_four :
    S 2 ∈ NormG (pmGamma1R 4) ∧ ∀ Q : ℕ, Q ∣ 4 → ¬ IsAtkinLehner 4 Q (S 2) := sorry

/-- The exception N = 4: |Nor(±Γ₁(4))/±Γ₁(4)| = |B(4)| = 6, not 2^{ω(4)} φ(4)/2 = 2. -/
theorem card_BG_pmGamma1R_four : Nat.card (BG (pmGamma1R 4)) = 6 := sorry

/-- **The order of the modular automorphism group of X₁(N)**:
|Nor(±Γ₁(N))/±Γ₁(N)| = 2^{ω(N)} φ(N)/2 for N ≥ 3, N ≠ 4.  (For N = 1, 2 the ℕ-division φ(N)/2 is 0,
