module

public import NormalizerDelta.StatementsStar

import Mathlib.Tactic

/-! Kernel-checked normalizer indices for Table 2 of
*Automorphisms of the modular curves `X_Δ(N)`*. -/

@[expose] public section

namespace NormalizerLean.Table2

open Finset

/-- The subgroup generated by `-1` and the two listed units. A row with one
listed generator uses `1` as its second generator. -/
def delta {N : ℕ} (a b : (ZMod N)ˣ) : Subgroup (ZMod N)ˣ :=
  Subgroup.zpowers (-1) ⊔ Subgroup.zpowers a ⊔ Subgroup.zpowers b

private def residue {N : ℕ} (u : (ZMod N)ˣ) : ℕ := (u : ZMod N).val

private def unitResidues (N : ℕ) : Finset ℕ :=
  (range N).filter (Nat.Coprime · N)

private def generatedResidues {N : ℕ} (a b : (ZMod N)ˣ) (r s : ℕ) : Finset ℕ :=
  (range 2 ×ˢ range r ×ˢ range s).image fun (i, j, k) => residue ((-1) ^ i * a ^ j * b ^ k)

private theorem mem_zpowers_iff_bounded_pow {G : Type*} [Group G] {a x : G} {r : ℕ}
    (hr : 0 < r) (ha : a ^ r = 1) : x ∈ Subgroup.zpowers a ↔ ∃ i < r, a ^ i = x := by
  classical
  constructor
  · have hf := isOfFinOrder_iff_pow_eq_one.mpr ⟨r, hr, ha⟩
    intro hx
    obtain ⟨i, hi, hix⟩ := mem_image.mp (hf.mem_zpowers_iff_mem_range_orderOf.mp hx)
    have hle : orderOf a ≤ r := Nat.le_of_dvd hr (orderOf_dvd_of_pow_eq_one ha)
    exact ⟨i, (mem_range.mp hi).trans_le hle, hix⟩
  · rintro ⟨i, _, rfl⟩
    exact (Subgroup.zpowers a).pow_mem (Subgroup.mem_zpowers a) _

private theorem mem_generatedResidues {N : ℕ} [NeZero N] (a b : (ZMod N)ˣ)
    {r s : ℕ} (hr : 0 < r) (hs : 0 < s) (ha : a ^ r = 1) (hb : b ^ s = 1)
    (u : (ZMod N)ˣ) : u ∈ delta a b ↔ residue u ∈ generatedResidues a b r s := by
  have hneg : (-1 : (ZMod N)ˣ) ^ 2 = 1 := by
    apply Units.ext
    simp
  have hinj : Function.Injective (residue (N := N)) :=
    fun _ _ h => Units.ext (ZMod.val_injective N h)
  constructor
  · intro hu
    obtain ⟨_, hleft, _, hb', rfl⟩ := Subgroup.mem_sup.mp hu
    obtain ⟨_, hneg', _, ha', rfl⟩ := Subgroup.mem_sup.mp hleft
    obtain ⟨i, hi, rfl⟩ := (mem_zpowers_iff_bounded_pow (by decide) hneg).mp hneg'
    obtain ⟨j, hj, rfl⟩ := (mem_zpowers_iff_bounded_pow hr ha).mp ha'
    obtain ⟨k, hk, rfl⟩ := (mem_zpowers_iff_bounded_pow hs hb).mp hb'
    exact mem_image.mpr ⟨(i, j, k), by simpa only [mem_product, mem_range] using ⟨hi, hj, hk⟩, rfl⟩
  · intro hu
    obtain ⟨⟨i, j, k⟩, hij, he⟩ := mem_image.mp hu
    rcases (show i < 2 ∧ j < r ∧ k < s by simpa using hij) with ⟨hi, hj, hk⟩
    apply Subgroup.mem_sup.mpr
    refine ⟨(-1) ^ i * a ^ j, Subgroup.mem_sup.mpr ⟨(-1) ^ i, ?_, a ^ j, ?_, rfl⟩,
      b ^ k, ?_, hinj he⟩
    · exact (mem_zpowers_iff_bounded_pow (by decide) hneg).mpr ⟨i, hi, rfl⟩
    · exact (mem_zpowers_iff_bounded_pow hr ha).mpr ⟨j, hj, rfl⟩
    · exact (mem_zpowers_iff_bounded_pow hs hb).mpr ⟨k, hk, rfl⟩

private def unitEquiv (N : ℕ) [NeZero N] : (ZMod N)ˣ ≃ {d // d ∈ unitResidues N} where
  toFun u := ⟨residue u, mem_filter.mpr ⟨mem_range.mpr (ZMod.val_lt _),
    ZMod.val_coe_unit_coprime u⟩⟩
  invFun d := ZMod.unitOfCoprime d.val (mem_filter.mp d.property).2
  left_inv u := by
    apply Units.ext
    rw [ZMod.coe_unitOfCoprime]
    exact ZMod.natCast_zmod_val _
  right_inv d := by
    apply Subtype.ext
    dsimp only [residue]
    rw [ZMod.coe_unitOfCoprime, ZMod.val_natCast_of_lt (mem_range.mp (mem_filter.mp d.property).1)]

private theorem forall_units_iff (N : ℕ) [NeZero N] (P : ℕ → Prop) :
    (∀ u : (ZMod N)ˣ, P (residue u)) ↔ ∀ u ∈ unitResidues N, P u := by
  constructor
  · intro h u hu
    obtain ⟨d, hd⟩ := (unitEquiv N).surjective ⟨u, hu⟩
    have he : residue d = u := congrArg Subtype.val hd
    exact he ▸ h d
  · exact fun h u => h _ ((unitEquiv N) u).property

private def admissible (N : ℕ) (members : Finset ℕ) (h : ℕ) : Prop :=
  0 < h ∧ h ^ 2 ∣ N ∧
    (∀ d ∈ unitResidues N, d ∈ members → d ^ 2 % h = 1 % h) ∧
    ∀ u ∈ unitResidues N, u % (N / h) = 1 % (N / h) → u ∈ members

private instance decidableAdmissible (N : ℕ) (members : Finset ℕ) : DecidablePred (admissible N members) :=
  fun h => inferInstanceAs (Decidable
    (0 < h ∧ h ^ 2 ∣ N ∧
      (∀ d ∈ unitResidues N, d ∈ members → d ^ 2 % h = 1 % h) ∧
      ∀ u ∈ unitResidues N, u % (N / h) = 1 % (N / h) → u ∈ members))

private theorem cast_sq_eq_one_iff {N : ℕ} [NeZero N] (u : (ZMod N)ˣ) (m : ℕ) :
    (ZMod.cast (u : ZMod N) : ZMod m) ^ 2 = 1 ↔ residue u ^ 2 % m = 1 % m := by
  rw [ZMod.cast_eq_val, ← Nat.cast_pow]
  simpa only [Nat.cast_one, residue] using ZMod.natCast_eq_natCast_iff' (residue u ^ 2) 1 m

private theorem isHStar_iff_admissible {N : ℕ} [NeZero N] (D : Subgroup (ZMod N)ˣ)
    (members : Finset ℕ) (coverage : ∀ u, u ∈ D ↔ residue u ∈ members) (h : ℕ) :
    IsHStar N D h ↔ admissible N members h := by
  have hone (u : (ZMod N)ˣ) :
      (ZMod.cast (u : ZMod N) : ZMod (N / h)) = 1 ↔ residue u % (N / h) = 1 % (N / h) := by
    rw [ZMod.cast_eq_val]
    simpa only [Nat.cast_one, residue] using
      ZMod.natCast_eq_natCast_iff' (residue u) 1 (N / h)
  unfold IsHStar admissible
  simp only [coverage, cast_sq_eq_one_iff, hone]
  rw [forall_units_iff N (fun d => d ∈ members → d ^ 2 % h = 1 % h),
      forall_units_iff N (fun u => u % (N / h) = 1 % (N / h) → u ∈ members)]

private theorem hStar_eq_findGreatest {N : ℕ} [NeZero N] (D : Subgroup (ZMod N)ˣ)
    (members : Finset ℕ) (coverage : ∀ u, u ∈ D ↔ residue u ∈ members) :
    hStar N D = Nat.findGreatest (admissible N members) N := by
  classical
  have same (b : ℕ) :
      @Nat.findGreatest (IsHStar N D) (Classical.decPred _) b =
        Nat.findGreatest (admissible N members) b := by
    induction b with
    | zero => rfl
    | succ b ih =>
      simp only [Nat.findGreatest_succ, isHStar_iff_admissible D members coverage, ih]
  exact same N

private def squaresToOne (members : Finset ℕ) (m : ℕ) : Prop :=
  ∀ d ∈ members, d ^ 2 % m = 1 % m

private instance (members : Finset ℕ) (m : ℕ) : Decidable (squaresToOne members m) :=
  inferInstanceAs (Decidable (∀ d ∈ members, d ^ 2 % m = 1 % m))

-- In these rows every exact divisor acts on the reduced subgroup by the
-- identity or by inversion. One side of the prime-power decomposition
-- consists entirely of components in which the subgroup has exponent ≤ 2.
private def fixesOrInverts (L : ℕ) (members : Finset ℕ) (Q : ℕ) : Prop :=
  (∀ p ∈ L.primeFactors, p ∣ Q → squaresToOne members (p ^ L.factorization p)) ∨
  (∀ p ∈ L.primeFactors, ¬ p ∣ Q → squaresToOne members (p ^ L.factorization p))

private instance (L : ℕ) (members : Finset ℕ) (Q : ℕ) :
    Decidable (fixesOrInverts L members Q) := by
  unfold fixesOrInverts
  infer_instance

private theorem isIotaStable_of_fixesOrInverts {N : ℕ} [NeZero N] (D : Subgroup (ZMod N)ˣ)
    (members : Finset ℕ) (coverage : ∀ u, u ∈ D ↔ residue u ∈ members) (Q : ℕ)
    (h : fixesOrInverts (N / hStar N D) members Q) :
    IsIotaStable N D Q := by
  let L := N / hStar N D
  have matchUnit (d : (ZMod N)ˣ) (hd : d ∈ D) :
      ∃ u ∈ D, IsIotaStar N D Q d u := by
    rcases h with hfix | hinv
    · refine ⟨d, hd, fun p hp => ?_⟩
      split_ifs with hpQ
      · simpa only [pow_two] using
          (cast_sq_eq_one_iff d (p ^ L.factorization p)).mpr (hfix p hp hpQ _ ((coverage d).mp hd))
      · rfl
    · refine ⟨d⁻¹, D.inv_mem hd, fun p hp => ?_⟩
      let m := p ^ L.factorization p
      have hm : m ∣ N := (Nat.ordProj_dvd L p).trans (Nat.div_dvd_of_dvd (hStar_dvd N D))
      have hinvMul : (ZMod.cast (↑(d⁻¹) : ZMod N) : ZMod m) * ZMod.cast (d : ZMod N) = 1 := by
        rw [cast_mul_cast hm, ← Units.val_mul, inv_mul_cancel, Units.val_one, cast_one' hm]
      split_ifs with hpQ
      · exact hinvMul
      · have hsq := (cast_sq_eq_one_iff d m).mpr (hinv p hp hpQ _ ((coverage d).mp hd))
        change (ZMod.cast (↑(d⁻¹) : ZMod N) : ZMod m) = ZMod.cast (d : ZMod N)
        linear_combination
          -(ZMod.cast (↑(d⁻¹) : ZMod N) : ZMod m) * hsq + ZMod.cast (d : ZMod N) * hinvMul
  intro u
  constructor
  · intro hu
    obtain ⟨d, hd, hdu⟩ := matchUnit u hu
    exact ⟨d, hd, isIotaStar_symm hdu⟩
  · rintro ⟨d, hd, hdu⟩
    obtain ⟨v, hv, hdv⟩ := matchUnit d hd
    exact (mem_iff_of_cast_eq (cast_eq_of_isIotaStar hdu hdv)).mpr hv

private def exactDivisors (n : ℕ) : Finset ℕ :=
  (range (n + 1)).filter fun Q => Q ∣ n ∧ Nat.Coprime Q (n / Q)

private theorem card_finset_subtype (s : Finset ℕ) : Nat.card {x // x ∈ s} = s.card := by
  rw [Nat.card_eq_fintype_card, Fintype.card_coe]

private theorem wStar_eq_card {N : ℕ} [NeZero N] (D : Subgroup (ZMod N)ˣ)
    (h : ∀ Q ∈ exactDivisors (nStar N D), IsIotaStable N D Q) :
    wStar N D = (exactDivisors (nStar N D)).card := by
  have hn : 0 < nStar N D := by
    have hm := nStar_mul N D
    by_contra! hh
    rw [Nat.eq_zero_of_le_zero hh, zero_mul] at hm
    exact NeZero.ne N hm.symm
  rw [← card_finset_subtype]
  unfold wStar
  apply Nat.card_congr (Equiv.subtypeEquivRight _)
  intro Q
  have hrange (hQ : Q ∣ nStar N D) : Q ∈ range (nStar N D + 1) :=
    mem_range.mpr (Nat.lt_succ_of_le (Nat.le_of_dvd hn hQ))
  constructor
  · rintro ⟨hQ, hc, _⟩
    exact mem_filter.mpr ⟨hrange hQ, hQ, hc⟩
  · intro hQ
    obtain ⟨hd, hc⟩ := (mem_filter.mp hQ).2
    exact ⟨hd, hc, h Q hQ⟩

private theorem index_eq_div {N : ℕ} [NeZero N] (D : Subgroup (ZMod N)ˣ)
    (members : Finset ℕ) (coverage : ∀ u, u ∈ D ↔ residue u ∈ members) :
    D.index = (unitResidues N).card / ((unitResidues N).filter (· ∈ members)).card := by
  have e : D ≃ {x // x ∈ (unitResidues N).filter (· ∈ members)} :=
    ((unitEquiv N).subtypeEquiv (p := (· ∈ D)) (q := fun n => n.val ∈ members)
      (fun u => coverage u)).trans
      { toFun := fun x => ⟨x.val.val, mem_filter.mpr ⟨x.val.property, x.property⟩⟩
        invFun := fun x => ⟨⟨x.val, (mem_filter.mp x.property).1⟩, (mem_filter.mp x.property).2⟩
        left_inv := by intro x; rfl
        right_inv := by intro x; rfl }
  have hD := (Nat.card_congr e).trans (card_finset_subtype _)
  have hU := (Nat.card_congr (unitEquiv N)).trans (card_finset_subtype _)
  have h := Subgroup.index_mul_card D
  rw [hD, hU] at h
  rw [← h, Nat.mul_div_cancel]
  exact Nat.card_pos (α := D) |> fun hpos => hD ▸ hpos

/-- A row of Table 2. The periods and `h` are witnesses for the finite
verification. -/
structure Row where
  level : ℕ
  generator₁ : ℕ
  generator₂ : ℕ
  diamondIndex : ℕ
  normalizerIndex : ℕ
  period₁ : ℕ
  period₂ : ℕ
  h : ℕ
  level_ne_zero : level ≠ 0
  coprime₁ : Nat.Coprime generator₁ level
  coprime₂ : Nat.Coprime generator₂ level

/-- Construct a row from numerals, checking that both generators are units. -/
def row (N a b i index r s h : ℕ) (hN : N ≠ 0 := by decide)
    (ha : Nat.Coprime a N := by decide) (hb : Nat.Coprime b N := by decide) : Row :=
  ⟨N, a, b, i, index, r, s, h, hN, ha, hb⟩

/-- The first listed generator as a unit modulo the level. -/
def Row.unit₁ (r : Row) : (ZMod r.level)ˣ := ZMod.unitOfCoprime _ r.coprime₁

/-- The second listed generator, or the identity for a one-generator row. -/
def Row.unit₂ (r : Row) : (ZMod r.level)ˣ := ZMod.unitOfCoprime _ r.coprime₂

/-- The subgroup generated by the residues in the paper's second column and by `-1`. -/
def Row.subgroup (r : Row) : Subgroup (ZMod r.level)ˣ := delta r.unit₁ r.unit₂

/-- The 28 entries of Table 2, ordered by level and generator. -/
def entries : Fin 28 → Row := ![
  row 49 27 1 3 168 14 1 7,
  row 50 29 1 2 120 10 1 5,
  row 75 4 1 2 120 10 1 5,
  row 75 59 1 4 240 10 1 5,
  row 81 8 1 3 324 18 1 9,
  row 98 13 1 3 336 14 1 7,
  row 100 9 1 2 360 10 1 10,
  row 100 19 1 4 240 10 1 5,
  row 121 10 1 5 660 22 1 11,
  row 125 4 1 2 100 50 1 5,
  row 125 24 1 10 500 10 1 5,
  row 147 8 1 3 336 14 1 7,
  row 147 20 1 6 672 14 1 7,
  row 150 11 1 2 240 10 1 5,
  row 150 29 1 4 480 10 1 5,
  row 162 17 1 3 648 18 1 9,
  row 169 12 1 6 1092 26 1 13,
  row 175 4 1 2 120 30 1 5,
  row 175 6 1 6 360 10 1 5,
  row 175 11 1 4 240 15 1 5,
  row 175 34 1 12 720 10 1 5,
  row 196 13 1 3 1008 14 1 14,
  row 196 27 1 6 672 14 1 7,
  row 200 9 1 4 240 10 1 5,
  row 200 9 11 2 480 10 10 10,
  row 200 11 1 4 240 10 1 5,
  row 200 19 1 4 960 10 1 10,
  row 200 39 1 8 480 10 1 5]

private def Row.members (r : Row) : Finset ℕ :=
  generatedResidues r.unit₁ r.unit₂ r.period₁ r.period₂

private def Check (r : Row) : Prop :=
  let N := r.level
  let n := N / r.h ^ 2
  let members := r.members
  0 < r.period₁ ∧ 0 < r.period₂ ∧ r.unit₁ ^ r.period₁ = 1 ∧ r.unit₂ ^ r.period₂ = 1 ∧
  Nat.findGreatest (admissible N members) N = r.h ∧ ¬ r.h ∣ 24 ∧
  (unitResidues N).card / ((unitResidues N).filter (· ∈ members)).card = r.diamondIndex ∧
  (∀ Q ∈ exactDivisors n, fixesOrInverts (N / r.h) members Q) ∧
  (r.diamondIndex : ℚ) * (psi N / psi n) * (exactDivisors n).card =
    r.normalizerIndex

private instance (r : Row) : Decidable (Check r) := by
  unfold Check
  infer_instance

private theorem verified_row (r : Row) (hr : Check r) :
    r.subgroup.index = r.diamondIndex ∧
    Nat.card (BG (GammaDeltaR r.level r.subgroup)) = r.normalizerIndex ∧
    ¬ NormG (GammaDeltaR r.level r.subgroup) ≤ Norm0 r.level := by
  let : NeZero r.level := ⟨r.level_ne_zero⟩
  obtain ⟨hr₁, hr₂, hp₁, hp₂, hmax, hn24, hi, hstable, hformula⟩ := hr
  have coverage (u : (ZMod r.level)ˣ) : u ∈ r.subgroup ↔ residue u ∈ r.members :=
    mem_generatedResidues _ _ hr₁ hr₂ hp₁ hp₂ u
  have hstar : hStar r.level r.subgroup = r.h :=
    (hStar_eq_findGreatest _ _ coverage).trans hmax
  have hi' : r.subgroup.index = r.diamondIndex :=
    (index_eq_div _ _ coverage).trans hi
  refine ⟨hi', ?_, ?_⟩
  · have he := card_BG_GammaDeltaR_hStar r.level r.subgroup
    have hw : wStar r.level r.subgroup = (exactDivisors (nStar r.level r.subgroup)).card := by
      refine wStar_eq_card _ (fun Q hQ => isIotaStable_of_fixesOrInverts _ _ coverage Q ?_)
      rw [nStar, hstar] at hQ
      rw [hstar]
      exact hstable Q hQ
    rw [hi', hw, nStar, hstar, hformula] at he
    exact_mod_cast he
  · intro hle
    have hd := (normG_GammaDeltaR_le_Norm0_iff r.level r.subgroup).mp hle
    rw [hstar] at hd
    exact hn24 (hd.trans (hPart_dvd_24 r.level))

private theorem checks (i : Fin 28) : Check (entries i) := by
  fin_cases i <;> decide +kernel

/-- Every published normalizer index in Table 2, together with the
corresponding diamond index and the normalizer noncontainment. -/
theorem indices (i : Fin 28) :
    let r := entries i
    r.subgroup.index = r.diamondIndex ∧
    Nat.card (BG (GammaDeltaR r.level r.subgroup)) = r.normalizerIndex ∧
    ¬ NormG (GammaDeltaR r.level r.subgroup) ≤ Norm0 r.level :=
  verified_row (entries i) (checks i)

end NormalizerLean.Table2
