module

public import NormalizerDelta.IndexComputation

import Mathlib.Tactic

/-! Kernel-checked normalizer indices for Table 2 of
*Automorphisms of the modular curves `X_Δ(N)`*. -/

@[expose] public section

namespace NormalizerLean.Table2

open Finset IndexComputation

/-- The subgroup generated by `-1` and the two listed units. A row with one
listed generator uses `1` as its second generator. -/
def delta {N : ℕ} (a b : (ZMod N)ˣ) : Subgroup (ZMod N)ˣ :=
  Subgroup.zpowers (-1) ⊔ Subgroup.zpowers a ⊔ Subgroup.zpowers b

private def generatedResidues {N : ℕ} (a b : (ZMod N)ˣ) (r s : ℕ) : Finset ℕ :=
  (range 2 ×ˢ range r ×ˢ range s).image fun (i, j, k) => residue ((-1) ^ i * a ^ j * b ^ k)

private theorem mem_generatedResidues {N : ℕ} [NeZero N] (a b : (ZMod N)ˣ)
    {r s : ℕ} (hr : 0 < r) (hs : 0 < s) (ha : a ^ r = 1) (hb : b ^ s = 1)
    (u : (ZMod N)ˣ) : u ∈ delta a b ↔ residue u ∈ generatedResidues a b r s := by
  have hneg : (-1 : (ZMod N)ˣ) ^ 2 = 1 := by
    apply Units.ext
    simp
  have hinj : Function.Injective (residue (N := N)) :=
    fun _ _ h => Units.ext (ZMod.val_injective N h)
  constructor
  · intro hu
    obtain ⟨_, hleft, _, hb', rfl⟩ := Subgroup.mem_sup.mp hu
    obtain ⟨_, hneg', _, ha', rfl⟩ := Subgroup.mem_sup.mp hleft
    obtain ⟨i, hi, rfl⟩ := (mem_zpowers_iff_bounded_pow (by decide) hneg).mp hneg'
    obtain ⟨j, hj, rfl⟩ := (mem_zpowers_iff_bounded_pow hr ha).mp ha'
    obtain ⟨k, hk, rfl⟩ := (mem_zpowers_iff_bounded_pow hs hb).mp hb'
    exact mem_image.mpr ⟨(i, j, k), by simpa only [mem_product, mem_range] using ⟨hi, hj, hk⟩, rfl⟩
  · intro hu
    obtain ⟨⟨i, j, k⟩, hij, he⟩ := mem_image.mp hu
    rcases (show i < 2 ∧ j < r ∧ k < s by simpa using hij) with ⟨hi, hj, hk⟩
    apply Subgroup.mem_sup.mpr
    refine ⟨(-1) ^ i * a ^ j, Subgroup.mem_sup.mpr ⟨(-1) ^ i, ?_, a ^ j, ?_, rfl⟩,
      b ^ k, ?_, hinj he⟩
    · exact (mem_zpowers_iff_bounded_pow (by decide) hneg).mpr ⟨i, hi, rfl⟩
    · exact (mem_zpowers_iff_bounded_pow hr ha).mpr ⟨j, hj, rfl⟩
    · exact (mem_zpowers_iff_bounded_pow hs hb).mpr ⟨k, hk, rfl⟩

/-- A row of Table 2. The periods and `h` are witnesses for the finite
verification. -/
structure Row where
  level : ℕ
  generator₁ : ℕ
  generator₂ : ℕ
  diamondIndex : ℕ
  normalizerIndex : ℕ
  period₁ : ℕ
  period₂ : ℕ
  h : ℕ
  level_ne_zero : level ≠ 0
  coprime₁ : Nat.Coprime generator₁ level
  coprime₂ : Nat.Coprime generator₂ level

/-- Construct a row from numerals, checking that both generators are units. -/
def row (N a b i index r s h : ℕ) (hN : N ≠ 0 := by decide)
    (ha : Nat.Coprime a N := by decide) (hb : Nat.Coprime b N := by decide) : Row :=
  ⟨N, a, b, i, index, r, s, h, hN, ha, hb⟩

/-- The first listed generator as a unit modulo the level. -/
def Row.unit₁ (r : Row) : (ZMod r.level)ˣ := ZMod.unitOfCoprime _ r.coprime₁

/-- The second listed generator, or the identity for a one-generator row. -/
def Row.unit₂ (r : Row) : (ZMod r.level)ˣ := ZMod.unitOfCoprime _ r.coprime₂

/-- The subgroup generated by the residues in the paper's second column and by `-1`. -/
def Row.subgroup (r : Row) : Subgroup (ZMod r.level)ˣ := delta r.unit₁ r.unit₂

/-- The 28 entries of Table 2, ordered by level and generator. -/
def entries : Fin 28 → Row := ![
  row 49 27 1 3 168 14 1 7,
  row 50 29 1 2 120 10 1 5,
  row 75 4 1 2 120 10 1 5,
  row 75 59 1 4 240 10 1 5,
  row 81 8 1 3 324 18 1 9,
  row 98 13 1 3 336 14 1 7,
  row 100 9 1 2 360 10 1 10,
  row 100 19 1 4 240 10 1 5,
  row 121 10 1 5 660 22 1 11,
  row 125 4 1 2 100 50 1 5,
  row 125 24 1 10 500 10 1 5,
  row 147 8 1 3 336 14 1 7,
  row 147 20 1 6 672 14 1 7,
  row 150 11 1 2 240 10 1 5,
  row 150 29 1 4 480 10 1 5,
  row 162 17 1 3 648 18 1 9,
  row 169 12 1 6 1092 26 1 13,
  row 175 4 1 2 120 30 1 5,
  row 175 6 1 6 360 10 1 5,
  row 175 11 1 4 240 15 1 5,
  row 175 34 1 12 720 10 1 5,
  row 196 13 1 3 1008 14 1 14,
  row 196 27 1 6 672 14 1 7,
  row 200 9 1 4 240 10 1 5,
  row 200 9 11 2 480 10 10 10,
  row 200 11 1 4 240 10 1 5,
  row 200 19 1 4 960 10 1 10,
  row 200 39 1 8 480 10 1 5]

private def Row.members (r : Row) : Finset ℕ :=
  generatedResidues r.unit₁ r.unit₂ r.period₁ r.period₂

private def Check (r : Row) : Prop :=
  let N := r.level
  let n := N / r.h ^ 2
  let members := r.members
  0 < r.period₁ ∧ 0 < r.period₂ ∧ r.unit₁ ^ r.period₁ = 1 ∧ r.unit₂ ^ r.period₂ = 1 ∧
  Nat.findGreatest (admissible N members) N = r.h ∧ ¬ r.h ∣ 24 ∧
  (unitResidues N).card / ((unitResidues N).filter (· ∈ members)).card = r.diamondIndex ∧
  (∀ Q ∈ exactDivisors n, fixesOrInverts (N / r.h) members Q) ∧
  (r.diamondIndex : ℚ) * (psi N / psi n) * (exactDivisors n).card =
    r.normalizerIndex

private instance (r : Row) : Decidable (Check r) := by
  unfold Check
  infer_instance

private theorem verified_row (r : Row) (hr : Check r) :
    r.subgroup.index = r.diamondIndex ∧
    Nat.card (BG (GammaDeltaR r.level r.subgroup)) = r.normalizerIndex ∧
    ¬ NormG (GammaDeltaR r.level r.subgroup) ≤ Norm0 r.level := by
  let : NeZero r.level := ⟨r.level_ne_zero⟩
  obtain ⟨hr₁, hr₂, hp₁, hp₂, hmax, hn24, hi, hstable, hformula⟩ := hr
  have coverage (u : (ZMod r.level)ˣ) : u ∈ r.subgroup ↔ residue u ∈ r.members :=
    mem_generatedResidues _ _ hr₁ hr₂ hp₁ hp₂ u
  obtain ⟨hstar, hi', hindex⟩ := indices_of_checks r.subgroup r.members r.h
    r.diamondIndex r.normalizerIndex coverage hmax hi hstable hformula
  refine ⟨hi', hindex, fun hle => hn24 ?_⟩
  have hd := (normG_GammaDeltaR_le_Norm0_iff r.level r.subgroup).mp hle
  rw [hstar] at hd
  exact hd.trans (hPart_dvd_24 r.level)

private theorem checks (i : Fin 28) : Check (entries i) := by
  fin_cases i <;> decide +kernel

/-- Every published normalizer index in Table 2, together with the
corresponding diamond index and the normalizer noncontainment. -/
theorem indices (i : Fin 28) :
    let r := entries i
    r.subgroup.index = r.diamondIndex ∧
    Nat.card (BG (GammaDeltaR r.level r.subgroup)) = r.normalizerIndex ∧
    ¬ NormG (GammaDeltaR r.level r.subgroup) ≤ Norm0 r.level :=
  verified_row (entries i) (checks i)

end NormalizerLean.Table2
