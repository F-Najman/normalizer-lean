module

public import NormalizerDelta.IndexComputation

import Mathlib.Tactic

/-! Kernel-checked modular automorphism counts for Table 1 of
*Automorphisms of the modular curves `X_Δ(N)`*. -/

@[expose] public section

namespace NormalizerLean.Table1

open Finset IndexComputation

/-- The subgroup generated by `-1` and the listed units, with unused generator slots set to `1`. -/
def delta {N : ℕ} (a b c : (ZMod N)ˣ) : Subgroup (ZMod N)ˣ :=
  Subgroup.zpowers (-1) ⊔ Subgroup.zpowers a ⊔ Subgroup.zpowers b ⊔ Subgroup.zpowers c

private def adjoinPowers {G : Type*} [Monoid G] [DecidableEq G]
    (known : Finset G) (a : G) (r : ℕ) : Finset G :=
  (known ×ˢ range r).image fun (x, j) => x * a ^ j

private theorem mem_adjoinPowers {G : Type*} [CommGroup G] [DecidableEq G]
    {S : Subgroup G} {known : Finset G} (hknown : ∀ x, x ∈ S ↔ x ∈ known)
    {a x : G} {r : ℕ} (hr : 0 < r) (ha : a ^ r = 1) :
    x ∈ S ⊔ Subgroup.zpowers a ↔ x ∈ adjoinPowers known a r := by
  constructor
  · intro hx
    obtain ⟨y, hy, _, hz, rfl⟩ := Subgroup.mem_sup.mp hx
    obtain ⟨j, hj, rfl⟩ := (mem_zpowers_iff_bounded_pow hr ha).mp hz
    exact mem_image.mpr ⟨(y, j), mem_product.mpr ⟨(hknown y).mp hy, mem_range.mpr hj⟩, rfl⟩
  · intro hx
    obtain ⟨⟨y, j⟩, hp, he⟩ := mem_image.mp hx
    obtain ⟨hy, hj⟩ := mem_product.mp hp
    exact Subgroup.mem_sup.mpr ⟨y, (hknown y).mpr hy, a ^ j,
      (mem_zpowers_iff_bounded_pow hr ha).mpr ⟨j, mem_range.mp hj, rfl⟩, he⟩

private def signs {N : ℕ} : Finset (ZMod N)ˣ :=
  (range 2).image fun j => (-1) ^ j

private theorem mem_signs {N : ℕ} (u : (ZMod N)ˣ) :
    u ∈ Subgroup.zpowers (-1) ↔ u ∈ signs := by
  have hneg : (-1 : (ZMod N)ˣ) ^ 2 = 1 := by
    apply Units.ext
    simp
  rw [mem_zpowers_iff_bounded_pow (by decide) hneg]
  simp only [signs, mem_image, mem_range]

private def generatedResidues {N : ℕ} (a b c : (ZMod N)ˣ) (r s t : ℕ) : Finset ℕ :=
  (adjoinPowers (adjoinPowers (adjoinPowers signs a r) b s) c t).image residue

private theorem mem_generatedResidues {N : ℕ} [NeZero N] (a b c : (ZMod N)ˣ)
    {r s t : ℕ} (hr : 0 < r) (hs : 0 < s) (ht : 0 < t)
    (ha : a ^ r = 1) (hb : b ^ s = 1) (hc : c ^ t = 1) (u : (ZMod N)ˣ) :
    u ∈ delta a b c ↔ residue u ∈ generatedResidues a b c r s t := by
  unfold delta generatedResidues
  rw [mem_adjoinPowers (fun x =>
    mem_adjoinPowers (fun y => mem_adjoinPowers mem_signs hr ha) hs hb) ht hc]
  constructor
  · intro hu
    exact mem_image.mpr ⟨u, hu, rfl⟩
  · intro hu
    obtain ⟨v, hv, he⟩ := mem_image.mp hu
    have : v = u := Units.ext (ZMod.val_injective N he)
    rwa [this] at hv

/-- A row of Table 1. The periods and `h` are witnesses for the finite verification. -/
structure Row where
  level : ℕ
  generator₁ : ℕ
  generator₂ : ℕ
  generator₃ : ℕ
  diamondIndex : ℕ
  modularCount : ℕ
  period₁ : ℕ
  period₂ : ℕ
  period₃ : ℕ
  h : ℕ
  level_ne_zero : level ≠ 0
  coprime₁ : Nat.Coprime generator₁ level
  coprime₂ : Nat.Coprime generator₂ level
  coprime₃ : Nat.Coprime generator₃ level

/-- Construct a row from numerals, checking that the generators are units. -/
def row (N a b c i count r s t h : ℕ) (hN : N ≠ 0 := by decide)
    (ha : Nat.Coprime a N := by decide) (hb : Nat.Coprime b N := by decide)
    (hc : Nat.Coprime c N := by decide) : Row :=
  ⟨N, a, b, c, i, count, r, s, t, h, hN, ha, hb, hc⟩

/-- The first listed generator as a unit modulo the level. -/
def Row.unit₁ (r : Row) : (ZMod r.level)ˣ := ZMod.unitOfCoprime _ r.coprime₁

/-- The second listed generator, or the identity if the slot is unused. -/
def Row.unit₂ (r : Row) : (ZMod r.level)ˣ := ZMod.unitOfCoprime _ r.coprime₂

/-- The third listed generator, or the identity if the slot is unused. -/
def Row.unit₃ (r : Row) : (ZMod r.level)ˣ := ZMod.unitOfCoprime _ r.coprime₃

/-- The subgroup generated by the residues in the paper's second column and by `-1`. -/
def Row.subgroup (r : Row) : Subgroup (ZMod r.level)ˣ := delta r.unit₁ r.unit₂ r.unit₃

