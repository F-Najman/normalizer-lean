private def Row.members (r : Row) : Finset ℕ :=
  generatedResidues r.unit₁ r.unit₂ r.unit₃ r.period₁ r.period₂ r.period₃

private def Check (r : Row) : Prop :=
  let N := r.level
  let n := N / r.h ^ 2
  let members := r.members
  0 < r.period₁ ∧ 0 < r.period₂ ∧ 0 < r.period₃ ∧
  r.unit₁ ^ r.period₁ = 1 ∧ r.unit₂ ^ r.period₂ = 1 ∧ r.unit₃ ^ r.period₃ = 1 ∧
  Nat.findGreatest (admissible N members) N = r.h ∧
  (unitResidues N).card / ((unitResidues N).filter (· ∈ members)).card = r.diamondIndex ∧
  (∀ Q ∈ exactDivisors n, fixesOrInverts (N / r.h) members Q) ∧
  (r.diamondIndex : ℚ) * (psi N / psi n) * (exactDivisors n).card = r.modularCount

private instance (r : Row) : Decidable (Check r) := by
  unfold Check
  infer_instance

private theorem verified_row (r : Row) (hr : Check r) :
    r.subgroup.index = r.diamondIndex ∧
    Nat.card (BG (GammaDeltaR r.level r.subgroup)) = r.modularCount := by
  let : NeZero r.level := ⟨r.level_ne_zero⟩
  obtain ⟨hr₁, hr₂, hr₃, hp₁, hp₂, hp₃, hmax, hi, hstable, hformula⟩ := hr
  have coverage (u : (ZMod r.level)ˣ) : u ∈ r.subgroup ↔ residue u ∈ r.members :=
    mem_generatedResidues _ _ _ hr₁ hr₂ hr₃ hp₁ hp₂ hp₃ u
  exact (indices_of_checks r.subgroup r.members r.h r.diamondIndex r.modularCount
    coverage hmax hi hstable hformula).2

private theorem checks (i : Fin 42) : Check (entries i) := by
  fin_cases i <;> decide +kernel

/-- Every published modular automorphism count in Table 1, together with the
corresponding diamond index. -/
theorem indices (i : Fin 42) :
    let r := entries i
    r.subgroup.index = r.diamondIndex ∧
    Nat.card (BG (GammaDeltaR r.level r.subgroup)) = r.modularCount :=
  verified_row (entries i) (checks i)

end NormalizerLean.Table1
